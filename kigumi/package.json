{
  "name": "kigumi",
  "displayName": "Kigumi",
  "description": "Kigumi is a viewer tool for kumiki designs",
  "version": "0.5.0",
  "publisher": "minimaple",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/minimapletinytools/kumiki/kigumi"
  },
  "engines": {
    "vscode": "^1.63.0"
  },
  "keywords": [
    "cad",
    "timber",
    "woodworking",
    "geometry",
    "viewer"
  ],
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:kigumi.openCurrentFileInViewer",
    "onCommand:kigumi.automationOpenFileInViewer",
    "onCommand:kigumi.automationListSessions",
    "onCommand:kigumi.automationRefreshSession",
    "onCommand:kigumi.captureScreenshot",
    "onCommand:kigumi.initializeProjectInWorkspace",
    "onView:kigumi.explorer"
  ],
  "main": "./extension.js",
  "icon": "templogo.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kigumi",
          "title": "Kigumi",
          "icon": "sidebar-icon.png"
        }
      ]
    },
    "views": {
      "kigumi": [
        {
          "id": "kigumi.explorer",
          "name": "Kigumi Explorer 🦋",
          "icon": "templogo.png"
        }
      ]
    },
    "commands": [
      {
        "command": "kigumi.openCurrentFileInViewer",
        "title": "%command.openCurrentFileInViewer.title%",
        "icon": "$(play)"
      },
      {
        "command": "kigumi.initializeProjectInWorkspace",
        "title": "%command.initializeProjectInWorkspace.title%",
        "icon": "$(rocket)"
      },
      {
        "command": "kigumi.refreshSidebar",
        "title": "%command.refreshSidebar.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "kigumi.toggleGroupByPatternbook",
        "title": "%command.toggleGroupByPatternbook.title%",
        "icon": "$(list-tree)"
      },
      {
        "command": "kigumi.updateKumiki",
        "title": "%command.updateKumiki.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "kigumi.openWebsite",
        "title": "%command.openWebsite.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "kigumi.toggleAutoRefreshOnFileChange",
        "title": "%command.toggleAutoRefreshOnFileChange.title%",
        "icon": "$(sync)"
      },
      {
        "command": "kigumi.automationListSessions",
        "title": "%command.automationListSessions.title%"
      },
      {
        "command": "kigumi.automationOpenFileInViewer",
        "title": "%command.automationOpenFileInViewer.title%"
      },
      {
        "command": "kigumi.automationRefreshSession",
        "title": "%command.automationRefreshSession.title%"
      },
      {
        "command": "kigumi.automationReadSessionLogs",
        "title": "%command.automationReadSessionLogs.title%"
      },
      {
        "command": "kigumi.automationGetCameraState",
        "title": "%command.automationGetCameraState.title%"
      },
      {
        "command": "kigumi.automationSetCameraState",
        "title": "%command.automationSetCameraState.title%"
      },
      {
        "command": "kigumi.captureScreenshot",
        "title": "%command.captureScreenshot.title%"
      },
      {
        "command": "kigumi.explorer",
        "title": "%command.explorer.title%",
        "icon": "$(file-directory)"
      },
      {
        "command": "kigumi.viewPatternSource",
        "title": "%command.viewPatternSource.title%",
        "category": "Kigumi",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kigumi.duplicatePatternToWorkspace",
        "title": "%command.duplicatePatternToWorkspace.title%",
        "category": "Kigumi",
        "icon": "$(copy)"
      },
      {
        "command": "kigumi.openPatternInNewWindow",
        "title": "%command.openPatternInNewWindow.title%",
        "category": "Kigumi"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kigumi.toggleGroupByPatternbook",
          "when": "view == kigumi.explorer",
          "group": "navigation@2"
        },
        {
          "command": "kigumi.refreshSidebar",
          "when": "view == kigumi.explorer",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kigumi.refreshSidebar",
          "when": "false"
        },
        {
          "command": "kigumi.toggleGroupByPatternbook",
          "when": "false"
        },
        {
          "command": "kigumi.updateKumiki",
          "when": "false"
        },
        {
          "command": "kigumi.openWebsite",
          "when": "false"
        },
        {
          "command": "kigumi.toggleAutoRefreshOnFileChange",
          "when": "false"
        },
        {
          "command": "kigumi.viewPatternSource",
          "when": "false"
        },
        {
          "command": "kigumi.duplicatePatternToWorkspace",
          "when": "false"
        },
        {
          "command": "kigumi.openPatternInNewWindow",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "kigumi.viewPatternSource",
          "when": "view == kigumi.explorer && (viewItem == frameFile || viewItem == patternItem || viewItem == patternItemWorkspace || viewItem == workspacePatternbook || viewItem == patternbookGroupItem)",
          "group": "inline@1"
        },
        {
          "command": "kigumi.duplicatePatternToWorkspace",
          "when": "view == kigumi.explorer && (viewItem == patternItem || viewItem == patternbookGroupItem)",
          "group": "inline@2"
        },
        {
          "command": "kigumi.openPatternInNewWindow",
          "when": "view == kigumi.explorer && (viewItem == patternItem || viewItem == patternItemWorkspace)",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Kigumi",
      "properties": {
        "kigumi.viewer.openInSplitView": {
          "type": "boolean",
          "default": false,
          "description": "%config.openInSplitView.description%"
        },
        "kigumi.viewer.autoRefreshOnFileChange": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoRefreshOnFileChange.description%"
        },
        "kigumi.viewer.showPoopTaggedJoints": {
          "type": "boolean",
          "default": false,
          "description": "%config.showPoopTaggedJoints.description%"
        },
        "kigumi.viewer.assemblyPreview": {
          "type": "boolean",
          "default": false,
          "description": "%config.assemblyPreview.description%"
        },
        "kigumi.viewer.drawingBeta": {
          "type": "boolean",
          "default": false,
          "description": "%config.drawingBeta.description%"
        },
        "kigumi.viewer.logRetentionDays": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "%config.logRetentionDays.description%"
        },
        "kigumi.sidebar.autoRefreshOnNewFile": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRefreshSidebarOnNewFile.description%"
        }
      }
    }
  },
  "scripts": {
    "prepare:instructions": "node ./scripts/prepare-bundled-instructions.js",
    "update-vendor": "node ./scripts/update-vendor.js",
    "vscode:prepublish": "npm run prepare:instructions",
    "test": "npm run test:unit",
    "test:unit": "jest",
    "test:runner": "jest --runInBand __tests__/runner-protocol.test.js",
    "test:ext": "node ./test/run-extension-tests.js",
    "test:ext:initial": "node ./test/run-extension-tests.js --suite initial",
    "test:ext:complex": "node ./test/run-extension-tests.js --suite complex",
    "test:ext:complex:grep": "node ./test/run-extension-tests.js --suite complex --grep",
    "test:all": "npm run test:unit && npm run test:ext"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "@vscode/test-electron": "^3.1.0",
    "@types/vscode": "^1.63.0",
    "jest": "^29.7.0",
    "mocha": "^11.2.2"
  }
}

---
// The About page, in each language (pages/about.astro, pages/ja/about.astro).
import Layout from '../layouts/Layout.astro';
import { type Lang, localePath, strings } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = strings(lang).about;
const home = strings(lang).home;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout
  title={s.title}
  description={s.description}
  canonicalPath="/about"
  image="/photos/oscarshed_built.png"
  lang={lang}
  translated
>
  <Fragment slot="masthead">
    <p class="kicker">Kumiki · 組木</p>
    <h1>{s.heading}</h1>
  </Fragment>
  <section class="about">
    <figure class="photo" data-reveal>
      <img src={`${base}/photos/oscarshed_built.png`} alt={home.gallery.oscarshed_built} loading="lazy" decoding="async" />
      <figcaption>{home.gallery.oscarshed_built}</figcaption>
    </figure>
    <div class="prose" data-reveal>
      {s.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
    </div>

    <div class="cta-row">
      <a class="btn btn-primary" href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">
        {s.github}
      </a>
      <a class="btn btn-secondary" href={localePath(lang, '/')}>
        {s.home}
      </a>
    </div>
  </section>
</Layout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 2rem;
  }
  .photo { grid-row: span 2; margin: 0; position: sticky; top: 6rem; transform: rotate(-2deg); }
  .photo img { display: block; width: 100%; height: auto; border: 6px solid var(--sheet); border-radius: 4px; box-shadow: var(--shadow-lg); }
  .photo figcaption { margin-top: 0.9rem; font-size: 0.85rem; color: var(--ink-faint); text-align: center; }
  .prose p { color: var(--ink-soft); font-size: 1.12rem; line-height: 1.75; margin: 0 0 1.4rem; }
  .prose p:first-child::first-letter {
    float: left;
    margin: 0.35rem 0.7rem 0 0;
    font-family: var(--serif);
    font-weight: 800;
    font-size: 4.2rem;
    line-height: 0.8;
    color: var(--shu);
  }
  .prose :global(strong) { color: var(--ink); }
  .cta-row { grid-column: 2; display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: -0.5rem; }
  @media (max-width: 800px) {
    .about { grid-template-columns: 1fr; }
    .photo { position: static; max-width: 20rem; margin: 0 auto; }
    .cta-row { grid-column: 1; }
  }
</style>

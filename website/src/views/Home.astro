---
// The home page, in each language (pages/index.astro, pages/ja/index.astro).
import JointSketch from '../components/JointSketch.astro';
import KigumiSlideshow from '../components/KigumiSlideshow.astro';
import Layout from '../layouts/Layout.astro';
import { appDownloads, kigumiVersion, marketplace } from '../kigumi-release';
import { type Lang, fill, localePath, strings } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const browserBuild = import.meta.env.PUBLIC_KIGUMI_TRY;
const browserUrl = browserBuild === 'true' ? `${base}/try/` : 'https://kumiki.build/try/';
const s = strings(lang).home;

const featureImages = [
  { id: 'program', image: 'feature_code.png', second: 'oscarshed.png' },
  { id: 'preview', image: 'kigumi-dovetailed-sawhorse-parameters.webp', second: 'double_sawhorse_xray.png' },
  { id: 'joinery', image: 'half_blind_cross_lap_joint_xray.png', second: 'mortise_tenon_brace_joint.png' },
  { id: 'drawings', image: 'kigumi-shed-shop-drawing.webp', beta: true },
  { id: 'assembly', image: 'feature_assembly.png', second: 'feature_assembly_2.png', beta: true },
];
const features = featureImages.map(({ id, image, second, beta }) => {
  const words = s.features[id as keyof typeof s.features];
  return {
    id,
    ...words,
    status: beta ? s.beta : undefined,
    image: `${base}/photos/${image}`,
    second: second ? `${base}/photos/${second}` : undefined,
    secondAlt: 'secondAlt' in words ? words.secondAlt : undefined,
  };
});

// Gallery tiles that take more than one cell of the mosaic.
const tileShape: Record<string, string> = {
  tinyhouse120_front: 'big',
  oscarshed_built: 'tall',
  round_crosslap_joint: 'tall',
  timber_frame_shed: 'wide',
  dropin_dovetail_butt_joint: 'wide',
  splined_opposing_joint: 'wide',
};
const gallery = Object.entries(s.gallery).map(([name, alt]) => ({
  src: `${base}/photos/${name}.png`,
  alt,
  shape: tileShape[name] ?? '',
}));

// Joint names for the ticker: kanji and romaji, the same in both languages.
const jointNames = [
  ['枘差し', 'Hozo-sashi'],
  ['腰掛鎌継ぎ', 'Koshikake kama-tsugi'],
  ['蟻落し', 'Ari-otoshi'],
  ['金輪継ぎ', 'Kanawa-tsugi'],
  ['車知栓', 'Shachi-sen'],
  ['渡り腮', 'Watari-ago'],
  ['割り楔枘', 'Warikusabi-hozo'],
  ['大入れ', 'Oire'],
  ['相欠き継ぎ', 'Aikaki-tsugi'],
  ['雇い枘', 'Yatoi-hozo'],
  ['組手', 'Kumite'],
];
---
<Layout
  title={s.title}
  description={s.description}
  canonicalPath="/"
  image="/photos/kigumi-tiny-house-workspace.webp"
  faqs={s.faqs}
  lang={lang}
  translated
  wide
>
  <section class="hero dark grid-bg">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="column hero-inner">
      <div class="hero-top">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{fill(s.eyebrow, { version: kigumiVersion })}</p>
          <h1>{s.heroTitle}</h1>
          <p class="tagline">{s.tagline}</p>
          <div class="cta">
            <a class="btn btn-primary" id="download" href={appDownloads.macArm}
               data-mac={appDownloads.macArm} data-windows={appDownloads.windows} data-other={localePath(lang, '/install')}
               data-windows-label={s.downloadWindows} data-other-label={s.getKigumi}>
              <svg class="btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13h10"/></svg>
              <span>{s.downloadMac}</span>
            </a>
            {browserBuild !== 'false' && <a class="btn btn-ghost" href={browserUrl}>{s.tryInBrowser} <span aria-hidden="true">→</span></a>}
            <a class="btn btn-ghost" href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">
              <svg class="btn-icon" viewBox="0 0 16 16" aria-hidden="true"><path class="fill" d="M8 .2a8 8 0 0 0-2.5 15.6c.4 0 .5-.2.5-.4v-1.5c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.5 7.5 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.8-3.6 4 .3.3.6.8.6 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 .2"/></svg>
              {s.github}
            </a>
          </div>
          <p class="also" set:html={fill(s.also, { version: kigumiVersion, ...appDownloads, marketplace })} />
        </div>
        <div class="hero-sketch">
          <JointSketch />
        </div>
      </div>

      <div class="hero-stage">
        <div class="window">
          <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>Kigumi</span></div>
          <KigumiSlideshow lang={lang} />
        </div>
        <figure class="code-card" aria-hidden="true">
          <figcaption><span class="file-dot"></span>my_cute_frame.py</figcaption>
<pre><code><span class="d">@frame</span>
<span class="k">def</span> <span class="f">my_cute_frame</span>(k: <span class="t">Optional</span>[<span class="t">Kiwari</span>] = <span class="k">None</span>) -&gt; <span class="t">Frame</span>:
    side = <span class="f">create_axis_aligned_timber</span>(
        length=<span class="f">mm</span>(<span class="n">600</span>), size=timber_size, ...)
    joint = <span class="f">cut_mortise_and_tenon_joint_on_face_aligned_timbers</span>(
        arrangement=<span class="t">ButtJointTimberArrangement</span>(
            receiving_timber=side, butt_timber=cross, ...),
        tenon_length=<span class="f">mm</span>(<span class="n">75</span>),
        peg_parameters=peg_params)
    <span class="k">return</span> <span class="t">Frame</span>.<span class="f">from_joints</span>([joint])</code></pre>
        </figure>
      </div>
    </div>
  </section>

  <section class="ticker" aria-label={s.marqueeLabel}>
    <div class="ticker-track">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? 'true' : undefined}>
          {jointNames.map(([kanji, romaji]) => (
            <li><span class="kanji" lang="ja">{kanji}</span><span class="romaji">{romaji}</span></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section class="column stats">
    {s.stats.map((stat, i) => (
      <div class="stat" data-reveal style={`--delay: ${i * 0.08}s`}>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))}
  </section>

  <section class="features" id="features">
    <div class="column">
      <div class="section-head" data-reveal>
        <p class="kicker">{s.featuresLabel}</p>
        <h2>{s.featuresTitle}</h2>
      </div>
      <div class="tabs" role="tablist" aria-label={s.featuresLabel} data-reveal>
        {features.map((feature, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${feature.id}`}
            aria-controls={`panel-${feature.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab-number">{String(i + 1).padStart(2, '0')}</span>
            <span class="tab-label">{feature.label}</span>
            {feature.status && <span class="status">{feature.status}</span>}
          </button>
        ))}
      </div>
      {features.map((feature, i) => (
        <section
          class="panel"
          role="tabpanel"
          id={`panel-${feature.id}`}
          aria-labelledby={`tab-${feature.id}`}
          hidden={i !== 0}
        >
          <div class="panel-copy">
            <p class="kicker">{feature.kicker}</p>
            <h3 class="panel-heading">{feature.heading}</h3>
            <p class="panel-body">{feature.body}</p>
            <ul class="panel-points">
              {feature.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>
          <div class={`panel-media${feature.second ? ' has-second' : ''}`}>
            <img class="plate" src={feature.image} alt={feature.imageAlt} loading="lazy" decoding="async" />
            {feature.second && (
              <img class="plate plate-second" src={feature.second} alt={feature.secondAlt} loading="lazy" decoding="async" />
            )}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="column gallery">
    <div class="section-head split" data-reveal>
      <h2>{s.galleryTitle}</h2>
      <p class="section-lead">{s.galleryLead}</p>
    </div>
    <div class="mosaic">
      {gallery.map((photo, i) => (
        <figure class={`tile ${photo.shape}`} data-reveal style={`--delay: ${(i % 4) * 0.06}s`}>
          <button class="thumb" type="button" data-index={i} aria-label={fill(s.galleryOpen, { alt: photo.alt })}>
            <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
            <span class="tile-caption" aria-hidden="true">{photo.alt}</span>
          </button>
        </figure>
      ))}
    </div>
  </section>

  <section class="agents dark grid-bg" id="ai-agents">
    <div class="column agents-inner">
      <div class="agents-copy" data-reveal>
        <p class="kicker">AI</p>
        <h2>{s.agentsTitle}</h2>
        <p class="section-lead">{s.agentsLead}</p>
        <div class="agents-ways">
          <div class="way-card">
            <span class="way-icon" aria-hidden="true">組</span>
            <h3>{s.kigumiAgentTitle}</h3>
            <p>{s.kigumiAgentBody}</p>
          </div>
          <div class="way-card">
            <span class="way-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-2.5-10-3 12"/></svg>
            </span>
            <h3>{s.ownAgentTitle}</h3>
            <p set:html={fill(s.ownAgentBody, { instructions: 'https://github.com/minimapletinytools/kumiki/blob/main/docs/agent_usage_instructions.md' })} />
          </div>
        </div>
      </div>
      <figure class="chat" data-reveal style="--delay: 0.15s">
        <figcaption class="chat-bar"><i></i><i></i><i></i><span>{s.promptCaption}</span></figcaption>
        <div class="chat-body">
          <div class="bubble user" data-reveal style="--delay: 0.4s">
            <span class="who">{s.chatYou}</span>
            <blockquote>{s.prompt}</blockquote>
          </div>
          <div class="bubble agent" data-reveal style="--delay: 1s">
            <span class="who"><span class="agent-mark" aria-hidden="true">組</span>{s.kigumiAgentTitle}</span>
            <p>{s.chatReply}</p>
            <img src={`${base}/photos/sawhorsey.png`} alt={s.gallery.sawhorsey} loading="lazy" decoding="async" />
          </div>
        </div>
      </figure>
    </div>
  </section>

  <section class="column faq" id="faq">
    <div class="faq-head" data-reveal>
      <p class="kicker">FAQ</p>
      <h2>{s.faqTitle}</h2>
      <span class="faq-kanji" aria-hidden="true">問</span>
    </div>
    <div class="faq-list" data-reveal>
      {s.faqs.map((faq) => (
        <details class="faq-item">
          <summary>
            <span>{faq.question}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="closing">
    <span class="closing-kanji" aria-hidden="true">木</span>
    <div class="column closing-inner" data-reveal>
      <h2>{s.closingTitle}</h2>
      <p>{s.closingBody}</p>
      <div class="cta">
        <a class="btn btn-ink" href={localePath(lang, '/install')}>{s.getStarted} <span aria-hidden="true">→</span></a>
        <a class="btn btn-outline" href="https://kumiki.build/docs/">{s.readDocs}</a>
      </div>
      <p class="community">
        <span>{s.community}</span>
        <a href="https://discord.gg/cQhUG7WJ8" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 5.5a16 16 0 0 1 10 0c1.8 2.2 3 5.8 3.5 10a11 11 0 0 1-4.5 2.8l-1.4-2a10 10 0 0 1-5.2 0l-1.4 2a11 11 0 0 1-4.5-2.8C4 11.3 5.2 7.7 7 5.5Z"/>
            <circle cx="9" cy="11.5" r="1" fill="currentColor"/><circle cx="15" cy="11.5" r="1" fill="currentColor"/>
          </svg>
          Discord
        </a>
        <a href="https://github.com/minimapletinytools/kumiki/discussions" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 4h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-1-2V6a2 2 0 0 1 2-2Z"/>
            <path d="M20 8a2 2 0 0 1 1 2v6a2 2 0 0 1-2 2v3l-4-3h-4M7 9h6"/>
          </svg>
          GitHub Discussions
        </a>
      </p>
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label={s.lightboxClose}>&times;</button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label={s.lightboxPrev}>&#8249;</button>
    <img class="lightbox-image" id="lightbox-image" src="" alt="" />
    <button class="lightbox-nav lightbox-next" type="button" aria-label={s.lightboxNext}>&#8250;</button>
    <p class="lightbox-caption" id="lightbox-caption"></p>
  </div>
</Layout>

<script>
  // --- feature tabs ----------------------------------------------------------
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));

  function select(index: number, focusTab = false, updateHash = true) {
    if (tabs.length === 0) return;
    const next = (index + tabs.length) % tabs.length;
    tabs.forEach((tab, i) => {
      const on = i === next;
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      tab.tabIndex = on ? 0 : -1;
    });
    panels.forEach((panel, i) => { panel.hidden = i !== next; });
    if (focusTab) tabs[next].focus();
    tabs[next].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    if (updateHash) history.replaceState(null, '', `#${panels[next].id.replace('panel-', '')}`);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    tab.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); select(i + 1, true); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(i - 1, true); }
      if (event.key === 'Home') { event.preventDefault(); select(0, true); }
      if (event.key === 'End') { event.preventDefault(); select(tabs.length - 1, true); }
    });
  });

  // Deep link: /#joinery opens that panel.
  const wanted = window.location.hash.replace('#', '');
  if (wanted) {
    const found = panels.findIndex((panel) => panel.id === `panel-${wanted}`);
    if (found >= 0) {
      select(found, false, false);
      document.getElementById('features')?.scrollIntoView();
    }
  }

  // --- gallery lightbox -----------------------------------------------------
  const gallery = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));
  const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-prev');
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-next');

  let currentIndex = 0;

  function show(index: number) {
    if (!lightbox || !lightboxImage || gallery.length === 0) return;
    currentIndex = (index + gallery.length) % gallery.length;
    const img = gallery[currentIndex].querySelector('img');
    if (!img) return;
    lightboxImage.src = img.src;
    lightboxImage.alt = img.alt;
    if (lightboxCaption) lightboxCaption.textContent = img.alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function close() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    gallery[currentIndex]?.focus();
  }

  gallery.forEach((btn, i) => btn.addEventListener('click', () => show(i)));
  closeBtn?.addEventListener('click', close);
  prevBtn?.addEventListener('click', () => show(currentIndex - 1));
  nextBtn?.addEventListener('click', () => show(currentIndex + 1));
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(currentIndex - 1);
    if (e.key === 'ArrowRight') show(currentIndex + 1);
  });

  // --- the hero's code card follows the pointer a little --------------------
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  if (stage && matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    stage.addEventListener('pointermove', (event) => {
      const box = stage.getBoundingClientRect();
      stage.style.setProperty('--px', String((event.clientX - box.left) / box.width - 0.5));
      stage.style.setProperty('--py', String((event.clientY - box.top) / box.height - 0.5));
    });
    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--px', '0');
      stage.style.setProperty('--py', '0');
    });
  }
</script>

<script>
  // The download button offers this computer's installer: Windows, a Mac, or the install page.
  const download = document.getElementById('download') as HTMLAnchorElement | null;
  const label = download?.querySelector('span');
  if (download && label) {
    const agent = navigator.userAgent;
    if (/Windows/.test(agent)) {
      download.href = download.dataset.windows ?? download.href;
      label.textContent = download.dataset.windowsLabel ?? label.textContent;
    } else if (!/Macintosh|Mac OS X/.test(agent) || /iPhone|iPad/.test(agent)) {
      download.href = download.dataset.other ?? download.href;
      label.textContent = download.dataset.otherLabel ?? label.textContent;
    }
  }
</script>

<style>
  /* ── Hero ── */
  .hero { position: relative; overflow: hidden; padding: clamp(3rem, 7vw, 5.5rem) 0 0; }
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(40rem 28rem at 82% 18%, rgba(212, 64, 31, 0.28), transparent 70%),
      radial-gradient(50rem 30rem at 15% 95%, rgba(232, 196, 140, 0.16), transparent 70%);
  }
  .hero-inner { position: relative; }
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem 3rem;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.6rem;
    padding: 0.35rem 0.9rem 0.35rem 0.7rem;
    border: 1px solid var(--line-dark-strong);
    border-radius: 999px;
    background: rgba(243, 236, 224, 0.04);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--on-dark-soft);
  }
  .pulse { position: relative; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--shu-bright); }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--shu-bright);
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse { to { transform: scale(3); opacity: 0; } }
  .hero h1 {
    font-size: clamp(2.6rem, 5.2vw, 4.6rem);
    line-height: 1.02;
    color: var(--on-dark);
    text-wrap: balance;
  }
  .hero h1:lang(ja) { font-size: clamp(2.2rem, 4.4vw, 3.8rem); line-height: 1.15; }
  .tagline { margin-top: 1.6rem; font-size: 1.15rem; color: var(--on-dark-soft); max-width: 36rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.2rem; }
  .btn-icon { width: 1.05em; height: 1.05em; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .btn-icon .fill { fill: currentColor; stroke: none; }
  .also { margin-top: 1.4rem; font-size: 0.88rem; color: var(--on-dark-faint); max-width: 34rem; }
  .also :global(a) { color: var(--on-dark-soft); text-decoration: underline; text-decoration-color: var(--line-dark-strong); text-underline-offset: 0.2em; }
  .also :global(a:hover) { color: var(--hinoki); }

  .hero-sketch { position: relative; }

  .hero-stage {
    --px: 0;
    --py: 0;
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-left: clamp(0rem, 8vw, 7rem);
    perspective: 2000px;
  }
  .window {
    position: relative;
    border-radius: 14px 14px 0 0;
    overflow: hidden;
    border: 1px solid var(--line-dark-strong);
    border-bottom: 0;
    background: var(--sumi-2);
    box-shadow: var(--shadow-lg), 0 0 0 8px rgba(243, 236, 224, 0.03);
    transform-origin: 50% 100%;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .window {
        animation: tilt linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }
    }
  }
  @keyframes tilt {
    from { transform: rotateX(16deg) scale(0.94); }
    to { transform: none; }
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.3rem;
    padding: 0 0.9rem;
    border-bottom: 1px solid var(--line-dark);
    background: var(--sumi-3);
  }
  .window-bar i, .chat-bar i { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: rgba(243, 236, 224, 0.16); }
  .window-bar i:first-child, .chat-bar i:first-child { background: var(--shu); }
  .window-bar span { margin-left: auto; margin-right: auto; padding-right: 3rem; font-family: var(--mono); font-size: 0.75rem; color: var(--on-dark-faint); }

  .code-card {
    position: absolute;
    left: 0;
    top: clamp(-3rem, -4vw, -1rem);

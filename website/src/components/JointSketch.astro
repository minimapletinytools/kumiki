<style>
  .joint-sketch { display: block; width: 100%; height: auto; overflow: visible; }
  path { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .edge { stroke: var(--hinoki); stroke-width: 1.4; }
  .edge.accent { stroke: var(--shu-bright); stroke-width: 1.6; }
  .label path { stroke: var(--shu-bright); stroke-width: 1; opacity: 0.8; }
  .label circle { fill: var(--shu-bright); }
  .label text { fill: var(--on-dark-soft); }
  .kanji { font-family: var(--serif); font-size: 14px; font-weight: 700; }
  .romaji { font-family: var(--mono); font-size: 10px; fill: var(--on-dark-faint); }
  .hidden-edge { stroke: var(--hinoki); stroke-width: 1; opacity: 0.45; stroke-dasharray: 4 5; }

  /* Exploded: the beam pulled out along +x, the peg along +y. */
  .beam { transform: translate(88px, 51px); }
  .peg { transform: translate(-100px, 58px); }

  @media (prefers-reduced-motion: no-preference) {
    .edge { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.8s cubic-bezier(0.6, 0, 0.3, 1) forwards; }
    .beam .edge { animation-delay: 0.5s; }
    .peg .edge { animation-delay: 0.9s; }
    .hidden-edge { opacity: 0; animation: fade 0.8s ease 1.6s forwards; }
    .beam { animation: beam 9s cubic-bezier(0.7, 0, 0.25, 1) 2.4s infinite; }
    .peg { animation: peg 9s cubic-bezier(0.7, 0, 0.25, 1) 2.4s infinite; }
    .labels { opacity: 0; animation: labels-in 0.6s ease 1.8s forwards; }
    .labels > g { animation: labels 9s ease 2.4s infinite; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 0.45; } }
  @keyframes labels-in { to { opacity: 1; } }
  @keyframes labels {
    0%, 4% { opacity: 1; }
    12%, 86% { opacity: 0; }
    96%, 100% { opacity: 1; }
  }
  @keyframes beam {
    0%, 8% { transform: translate(88px, 51px); }
    22%, 78% { transform: translate(0, 0); }
    92%, 100% { transform: translate(88px, 51px); }
  }
  @keyframes peg {
    0%, 26% { transform: translate(-100px, 58px); }
    38%, 70% { transform: translate(0, 0); }
    82%, 100% { transform: translate(-100px, 58px); }
  }
</style>

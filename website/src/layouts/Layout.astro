---
import { kigumiVersion, releasePage } from '../kigumi-release';
import { type Lang, localePath, strings } from '../i18n';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: string;
  keywords?: string;
  faqs?: { question: string; answer: string }[];
  /** Let the page run full width and manage its own columns, so full-bleed
      section bands are actually full width rather than faked with 100vw. */
  wide?: boolean;
  lang?: Lang;
  /** The page is in every language: at canonicalPath and at /ja + canonicalPath. */
  translated?: boolean;
}

const {
  title,
  lang = 'en',
  translated = false,
  description = strings(lang).layout.description,
  image = '/photos/tinyhouse120_angle.png',
  canonicalPath,
  type = 'website',
  keywords = 'timber framing, woodworking CAD, programmatic CAD, Python CAD, Japanese joinery, parametric joinery, Kigumi, Kumiki, mortise and tenon, dovetail joint, scarf joint, kanawa-tsugi, koshikake kama-tsugi, VS Code CAD, agentic CAD, AI timber framing, OpenSCAD alternative, CadQuery alternative',
  faqs,
  wide = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const s = strings(lang).layout;
const other: Lang = lang === 'en' ? 'ja' : 'en';
// The other language's version of this page; an untranslated page offers the other's home page.
const otherHref = translated && canonicalPath ? localePath(other, canonicalPath) : localePath(other, '/');
const link = (path: string) => localePath(lang, path);
// Kigumi in the browser, at /try: built only when the KIGUMI_TRY repo variable is on (deploy-website.yml).
const tryKigumi = import.meta.env.PUBLIC_KIGUMI_TRY === 'true';
const siteUrl = 'https://kumiki.build';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const urlFor = (one: Lang, path: string) => `${siteUrl}${localePath(one, path).slice(base.length)}`;
const canonicalUrl = canonicalPath ? urlFor(lang, canonicalPath) : `${siteUrl}${pathname === '/' ? '' : pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

const graphNodes: any[] = [
  {
    '@type': 'WebSite',
    '@id': 'https://kumiki.build/#website',
    url: 'https://kumiki.build/',
    name: 'Kumiki',
    alternateName: ['Kumiki CAD', 'Kumiki & Kigumi'],
    description: 'Programmatic CAD library for Python designed for timber framing and woodworking joinery.',
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'minimaple',
      url: 'https://kumiki.build',
    },
    sameAs: [
      'https://github.com/minimapletinytools/kumiki',
      'https://pypi.org/project/kumiki/',
      'https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi',
      'https://open-vsx.org/extension/minimaple/kigumi',
      'https://www.youtube.com/playlist?list=PLWKU1B561fyM',
    ],
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://kumiki.build/#software-kumiki',
    name: 'Kumiki',
    applicationCategory: 'CADApplication, DeveloperApplication',
    operatingSystem: 'Cross-platform (macOS, Linux, Windows)',
    softwareVersion: kigumiVersion,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Programmatic CAD library for Python designed for timber framing and woodworking with parametric joinery, 2D shop drawings, assembly order verification, and AI agent workflows.',
    featureList: [
      'Parametric Japanese and Western timber joinery (mortise and tenon, dovetail, scarf, gooseneck, lap, housing)',
      'Exact symbolic rational arithmetic for dimensions and angles',
      'Wood grain orientation and reference arris/face semantics',
      'Automated 2D shop drawings and elevations',
      'Physical assembly sequence solver and timeline playback',
      'STEP, STL, OBJ, and 3MF export',
    ],
    screenshot: `${siteUrl}/photos/tinyhouse120_angle.png`,
    url: 'https://kumiki.build',
    downloadUrl: 'https://pypi.org/project/kumiki/',
    codeRepository: 'https://github.com/minimapletinytools/kumiki',
    license: 'https://www.mozilla.org/MPL/2.0/',
  },
  {
    '@type': 'SoftwareSourceCode',
    '@id': 'https://kumiki.build/#source-kumiki',
    name: 'kumiki',
    codeRepository: 'https://github.com/minimapletinytools/kumiki',
    programmingLanguage: 'Python',
    runtimePlatform: 'Python >=3.10',
    version: kigumiVersion,
    license: 'https://www.mozilla.org/MPL/2.0/',
    targetProduct: { '@id': 'https://kumiki.build/#software-kumiki' },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://kumiki.build/#software-kigumi',
    name: 'Kigumi',
    applicationCategory: 'DeveloperApplication, CADApplication',
    operatingSystem: 'macOS, Windows, Visual Studio Code, Cursor, web browser',
    softwareVersion: kigumiVersion,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Interactive 3D timber frame viewer and editor for Kumiki: a desktop app for macOS and Windows, an extension for Visual Studio Code and Cursor, and a browser version with a built-in AI agent and MCP server.',
    url: 'https://kumiki.build/install',
    installUrl: 'https://kumiki.build/install',
    downloadUrl: 'https://kumiki.build/install',
    releaseNotes: releasePage,
    screenshot: `${siteUrl}/photos/double_sawhorse_xray.png`,
  },
];

const effectivePath = canonicalPath || pathname;
if (effectivePath && effectivePath !== '/') {
  graphNodes.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Kumiki',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: title.split('—')[0].trim(),
        item: canonicalUrl,
      },
    ],
  });
}

if (faqs && faqs.length > 0) {
  graphNodes.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Shippori+Mincho+B1:wght@600;700&display=swap" />

    <!-- Canonical & Agent Discovery Links -->
    <link rel="canonical" href={canonicalUrl} />
    {translated && canonicalPath && (['en', 'ja'] as Lang[]).map((one) => (
      <link rel="alternate" hreflang={one} href={urlFor(one, canonicalPath)} />
    ))}
    {translated && canonicalPath && <link rel="alternate" hreflang="x-default" href={urlFor('en', canonicalPath)} />}
    <!-- A first visit from a Japanese browser goes to the Japanese page; the header's switch is remembered. -->
    {translated && lang === 'en' && (
      <script is:inline define:vars={{ target: otherHref }}>
        try {
          const chosen = localStorage.getItem('kumiki.lang');
          const browser = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
          if (chosen === 'ja' || (!chosen && browser.startsWith('ja'))) location.replace(target + location.hash);
        } catch (_error) {}
      </script>
    )}
    <link rel="alternate" type="text/markdown" title="LLM Context Summary" href={`${siteUrl}/llms.txt`} />
    <link rel="help" title="Comprehensive LLM Guide" href={`${siteUrl}/llms-full.txt`} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteUrl}/sitemap.xml`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Kumiki" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    {translated && <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={s.imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- SEO Meta Tags -->
    <meta name="keywords" content={keywords} />
    <meta name="author" content="minimaple" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Cloudflare Web Analytics: cookieless page counts, on kumiki.build only (not local previews). -->
    <script is:inline>
    if (location.hostname === 'kumiki.build') {
      const beacon = document.createElement('script');
      beacon.type = 'module';
      beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      beacon.dataset.cfBeacon = '{"token": "7177885348334f15b71652a3e776a1ba"}';
      document.head.append(beacon);
    }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={link('/')}>
        <span class="brand-mark" aria-hidden="true">組</span>
        <span class="brand-text">Kumiki</span>
      </a>
      <nav class="site-nav" aria-label={s.nav.label}>
        <a href={link('/install')}>{s.nav.download}</a>
        {tryKigumi && <a href={`${base}/try/`}>{s.nav.try}</a>}
        <a href={link('/joints')}>{s.nav.joints}</a>
        <a href="https://kumiki.build/docs/">{s.nav.docs}</a>
        <a href="https://www.youtube.com/playlist?list=PLWKU1B561fyM" target="_blank" rel="noreferrer">{s.nav.videos}</a>
        <a href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">{s.nav.github}</a>
        <a href={link('/about')}>{s.nav.about}</a>
        <a class="language-switch" href={otherHref} hreflang={other} lang={other} data-lang={other}
           aria-label={translated ? s.language.switchToLabel : s.language.switchToHomeLabel}>{s.language.switchTo}</a>
      </nav>
    </header>
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-nav">
        <div class="footer-col">
          <h2 class="footer-heading">{s.footer.kigumi}</h2>
          <a href={link('/install')}>{s.footer.downloadApp}</a>
          {tryKigumi && <a href={`${base}/try/`}>{s.footer.tryInBrowser}</a>}
          <a href="https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi" target="_blank" rel="noreferrer">{s.footer.vscode}</a>
          <a href="https://open-vsx.org/extension/minimaple/kigumi" target="_blank" rel="noreferrer">{s.footer.openVsx}</a>
          <a href="https://github.com/minimapletinytools/kumiki/releases" target="_blank" rel="noreferrer">{s.footer.releases}</a>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{s.footer.documentation}</h2>
          <a href="https://kumiki.build/docs/">{s.footer.overview}</a>
          <a href="https://kumiki.build/docs/concepts/">{s.footer.concepts}</a>
          <a href={link('/joints')}>{s.footer.jointCatalog}</a>
          <a href="https://kumiki.build/docs/reference/">{s.footer.apiReference}</a>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{s.footer.forAgents}</h2>
          <a href={`${base}/llms.txt`}>llms.txt</a>
          <a href={`${base}/llms-full.txt`}>llms-full.txt</a>
          <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/agent_usage_instructions.md" target="_blank" rel="noreferrer">{s.footer.authoringInstructions}</a>
          <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/api_cheat_sheet.md" target="_blank" rel="noreferrer">{s.footer.cheatSheet}</a>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{s.footer.project}</h2>
          <a href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">{s.footer.github}</a>
          <a href="https://www.youtube.com/playlist?list=PLWKU1B561fyM" target="_blank" rel="noreferrer">{s.footer.videos}</a>
          <a href={link('/about')}>{s.footer.about}</a>
          <a href="mailto:minimapletinytools@gmail.com">{s.footer.contact}</a>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{s.footer.community}</h2>
          <a href="https://github.com/minimapletinytools/kumiki/discussions" target="_blank" rel="noreferrer">{s.footer.discussions}</a>
          <a href="https://discord.gg/cQhUG7WJ8" target="_blank" rel="noreferrer">{s.footer.discord}</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span set:html={s.footer.copyright} />
        <span class="footer-legal"><a href={`${base}/privacy`}>{s.footer.privacy}</a> <a href={`${base}/terms`}>{s.footer.terms}</a></span>
      </div>
    </footer>
    <script>
      // The language switch is remembered, so a Japanese browser that picks English stays there.
      document.querySelector<HTMLAnchorElement>('.language-switch')?.addEventListener('click', (event) => {
        try {
          localStorage.setItem('kumiki.lang', (event.currentTarget as HTMLAnchorElement).dataset.lang ?? 'en');
        } catch (_error) {}
      });
    </script>
    <style is:global>
      :root {
        /* Paper, sumi ink and indigo: a carpenter's drawing, not a craft shop. The timber colour
           stays in the renders and in the bands they sit on. */
        --paper: #f4f4f1;
        --sheet: #ffffff;
        --wood: #ebe4d6;
        --ink: #1e1f22;
        --ink-soft: #4a4d53;
        --ink-faint: #75787e;
        --rule: #d6d7d2;
        --rule-strong: #b3b5ae;
        --accent: #2c4e80;
        --accent-deep: #213c63;
        --accent-tint: #e4eaf3;
        --serif: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho", Georgia, serif;
        --sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --max: 1200px;
        --radius: 4px;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible, summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .site-header {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.4rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: var(--ink);
        font-family: var(--serif);
        font-weight: 700;
        font-size: 1.3rem;
      }
      .brand:hover { text-decoration: none; }
      .brand-mark {
        display: inline-grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: var(--radius);
        background: var(--ink);
        color: var(--paper);
        font-size: 1.15rem;
        line-height: 1;
      }

      .site-nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; font-size: 0.95rem; }
      .site-nav a { color: var(--ink-soft); }
      .site-nav a:hover { color: var(--ink); text-decoration: none; }
      .site-nav .language-switch { color: var(--accent); }

      main { max-width: var(--max); margin: 0 auto; padding: 1rem 1.5rem 5rem; }
      main.wide { max-width: none; padding: 0 0 5rem; }
      /* The column a wide page puts its own content back into. */
      .column { max-width: var(--max); margin: 0 auto; padding: 0 1.5rem; }

      .site-footer {
        border-top: 1px solid var(--rule);
        color: var(--ink-soft);
        font-size: 0.92rem;
      }
      .footer-nav {
        max-width: var(--max);
        margin: 0 auto;
        padding: 3rem 1.5rem 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 2rem;
      }
      .footer-col { display: flex; flex-direction: column; gap: 0.5rem; }
      .footer-heading {
        font-family: var(--sans);
        font-size: 0.92rem;
        font-weight: 600;
        letter-spacing: 0;
        color: var(--ink);
        margin: 0 0 0.25rem;
      }
      .footer-col a { color: var(--ink-soft); }
      .footer-col a:hover { color: var(--accent); }
      .footer-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.25rem 1.5rem 2.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        font-size: 0.85rem;
        color: var(--ink-faint);
      }
      .footer-legal { display: flex; gap: 1.25rem; }
      .footer-bottom a { color: inherit; }

      h1, h2 { font-family: var(--serif); font-weight: 700; line-height: 1.15; letter-spacing: -0.005em; margin: 0; }
      h1 { font-size: clamp(2.4rem, 5vw, 3.7rem); }
      h2 { font-size: clamp(1.7rem, 3vw, 2.35rem); }
      h3 { font-size: 1.08rem; font-weight: 600; line-height: 1.35; margin: 0; }
      p { margin: 0; }
      /* Japanese headings break between phrases, not inside a word. */
      :lang(ja) :is(h1, h2, h3) { word-break: auto-phrase; letter-spacing: 0; }

      /* What a section is about, when its heading doesn't say: sentence case, in the accent. */
      .kicker { color: var(--accent); font-weight: 500; font-size: 0.95rem; margin: 0 0 0.6rem; }

      /* A full-width band: the timber colour, for the sections the renders sit in. */
      .band { background: var(--wood); }
      .band-inner { max-width: var(--max); margin: 0 auto; padding: 5rem 1.5rem; }

      /* A render on its sheet: white, with an edge, as a print pinned to a board. */
      .plate {
        display: block;
        width: 100%;
        height: auto;
        background: var(--sheet);
        border: 1px solid var(--rule-strong);
        border-radius: var(--radius);
      }

      .status {
        display: inline-block;
        padding: 0.05rem 0.45rem;
        border-radius: 3px;
        font-size: 0.75rem;
        font-weight: 500;
        line-height: 1.5;
        color: var(--accent);
        background: var(--accent-tint);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius);
        font-family: var(--sans);
        font-weight: 500;
        font-size: 1rem;
        line-height: 1.3;
        border: 1px solid transparent;
        transition: background-color 0.15s ease, border-color 0.15s ease;
      }
      .btn:hover { text-decoration: none; }
      .btn-primary { background: var(--accent); color: #fff; }
      .btn-primary:hover { background: var(--accent-deep); }
      .btn-secondary { background: var(--sheet); color: var(--ink); border-color: var(--rule-strong); }
      .btn-secondary:hover { border-color: var(--ink); }
      .btn-sm { padding: 0.45rem 0.85rem; font-size: 0.9rem; }

      code, pre { font-family: var(--mono); font-size: 0.9em; }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; scroll-behavior: auto !important; }
      }
    </style>
  </body>
</html>

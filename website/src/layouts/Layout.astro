---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: string;
  faqs?: { question: string; answer: string }[];
  /** Let the page run full width and manage its own columns, so full-bleed
      section bands are actually full width rather than faked with 100vw. */
  wide?: boolean;
}

const {
  title,
  description = 'Kumiki is an open-source programmatic CAD library for Python designed for timber framing and woodworking joinery, with real parametric joinery and live 3D preview in VS Code via Kigumi.',
  image = '/photos/tinyhouse120_angle.png',
  canonicalPath,
  type = 'website',
  faqs,
  wide = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://kumiki.build';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : `${siteUrl}${pathname === '/' ? '' : pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

const graphNodes: any[] = [
  {
    '@type': 'WebSite',
    '@id': 'https://kumiki.build/#website',
    url: 'https://kumiki.build/',
    name: 'Kumiki',
    description: 'Programmatic CAD library for Python designed for timber framing and woodworking joinery.',
    publisher: {
      '@type': 'Organization',
      name: 'minimaple',
      url: 'https://kumiki.build',
    },
    sameAs: [
      'https://github.com/minimapletinytools/kumiki',
      'https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi',
      'https://open-vsx.org/extension/minimaple/kigumi',
      'https://www.youtube.com/playlist?list=PLWKU1B561fyM',
    ],
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://kumiki.build/#software-kumiki',
    name: 'Kumiki',
    applicationCategory: 'CADApplication, DeveloperApplication',
    operatingSystem: 'Cross-platform (macOS, Linux, Windows)',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Programmatic CAD library for Python designed for timber framing and woodworking with parametric joinery and agentic workflows.',
    url: 'https://kumiki.build',
    codeRepository: 'https://github.com/minimapletinytools/kumiki',
    license: 'https://www.mozilla.org/MPL/2.0/',
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://kumiki.build/#software-kigumi',
    name: 'Kigumi',
    applicationCategory: 'DeveloperApplication, CADApplication',
    operatingSystem: 'Visual Studio Code, Cursor',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Interactive 3D timber frame viewer and CSG inspection tool for Visual Studio Code and Cursor.',
    url: 'https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi',
    installUrl: 'https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi',
  },
];

if (faqs && faqs.length > 0) {
  graphNodes.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${base}/photos/wedged_half_dovetail.png`} />

    <!-- Canonical & Agent Discovery Links -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" title="LLM Context Summary" href={`${siteUrl}/llms.txt`} />
    <link rel="help" title="Comprehensive LLM Guide" href={`${siteUrl}/llms-full.txt`} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteUrl}/sitemap.xml`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Kumiki" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Kumiki timber frame CAD preview" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- SEO Meta Tags -->
    <meta name="keywords" content="timber framing, woodworking CAD, programmatic CAD, Python CAD, Japanese joinery, parametric joinery, Kigumi, mortise and tenon, dovetail joint, VS Code CAD, agentic CAD, AI timber framing" />
    <meta name="author" content="minimaple" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>
        <span class="brand-mark">組</span>
        <span class="brand-text">Kumiki</span>
      </a>
      <nav class="site-nav">
        <a href={`${base}/install`}>Install</a>
        <a href="https://kumiki.build/docs/" target="_blank" rel="noreferrer">Docs</a>
        <a href="https://www.youtube.com/playlist?list=PLWKU1B561fyM" target="_blank" rel="noreferrer">Videos</a>
        <a href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">GitHub</a>
        <a href={`${base}/about`}>About</a>
      </nav>
    </header>
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-nav">
        <div class="footer-col">
          <span class="footer-heading">Product</span>
          <a href={`${base}/install`}>Install Guide</a>
          <a href="https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi" target="_blank" rel="noreferrer">VS Code Extension</a>
          <a href="https://open-vsx.org/extension/minimaple/kigumi" target="_blank" rel="noreferrer">OpenVSX (Cursor)</a>
          <a href="https://github.com/minimapletinytools/kumiki/releases" target="_blank" rel="noreferrer">Releases</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">Documentation</span>
          <a href="https://kumiki.build/docs/" target="_blank" rel="noreferrer">Docs Overview</a>
          <a href="https://kumiki.build/docs/concepts/" target="_blank" rel="noreferrer">Concepts</a>
          <a href="https://kumiki.build/docs/patternbook/" target="_blank" rel="noreferrer">Pattern Book</a>
          <a href="https://kumiki.build/docs/reference/" target="_blank" rel="noreferrer">API Reference</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">AI &amp; Agents</span>
          <a href={`${base}/llms.txt`}>Agent Summary (llms.txt)</a>
          <a href={`${base}/llms-full.txt`}>Full Agent Guide (llms-full.txt)</a>
          <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/agent_usage_instructions.md" target="_blank" rel="noreferrer">Agent Instructions</a>
        </div>
        <div class="footer-col">
          <span class="footer-heading">Community &amp; Code</span>
          <a href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.youtube.com/playlist?list=PLWKU1B561fyM" target="_blank" rel="noreferrer">Video Tutorials</a>
          <a href={`${base}/about`}>About Kumiki</a>
          <a href="mailto:minimapletinytools@gmail.com">Contact</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; 2026 minimaple &middot; Open source under MPL-2.0</span>
        <span>Kumiki &amp; Kigumi</span>
      </div>
    </footer>

    <style is:global>
      :root {
        /* Warm, because the subject is timber -- a cold grey palette would be
           a lie about what this is for. Seriousness comes from structure and
           density instead: a deeper ground so renders sit ON something rather
           than dissolving into the page, a wider type scale, and less
           rounding. */
        --bg: #efe9de;
        --bg-deep: #e5dccd;
        --surface: #fdfaf4;
        --paper: #fffdf8;
        --ink: #191410;
        --ink-soft: #574c3e;
        --ink-faint: #8a7c68;
        --accent: #9c3f12;
        --accent-soft: #e8a26c;
        --border: #cdbfa5;
        --border-soft: #ded3c0;
        --shadow: 0 1px 2px rgba(25, 20, 16, 0.05), 0 12px 32px rgba(25, 20, 16, 0.09);
        --shadow-lift: 0 2px 4px rgba(25, 20, 16, 0.06), 0 22px 50px rgba(25, 20, 16, 0.13);
        --max: 1280px;
        --radius: 0.35rem;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .site-header {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.5rem 1.5rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: 0.01em;
      }
      .brand:hover { text-decoration: none; }
      .brand-mark {
        display: inline-grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        background: var(--ink);
        color: var(--surface);
        border-radius: var(--radius);
        font-size: 1.05rem;
        font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
      }

      .site-nav {
        display: flex;
        gap: 1.5rem;
        font-weight: 500;
        font-size: 0.94rem;
      }
      .site-nav a { color: var(--ink-soft); }
      .site-nav a:hover { color: var(--ink); text-decoration: none; }

      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1rem 1.5rem 4rem;
      }
      main.wide { max-width: none; padding: 0 0 4rem; }
      /* The column a wide page puts its own content back into. */
      .column { max-width: var(--max); margin: 0 auto; padding: 0 1.5rem; }

      .site-footer {
        max-width: var(--max);
        margin: 0 auto;
        padding: 3rem 1.5rem 2.5rem;
        color: var(--ink-soft);
        font-size: 0.9rem;
        border-top: 1px solid var(--border);
      }
      .footer-nav {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 2rem;
        margin-bottom: 2.5rem;
      }
      .footer-col {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }
      .footer-heading {
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: 0.2rem;
      }
      .footer-col a {
        color: var(--ink-soft);
        font-size: 0.92rem;
      }
      .footer-col a:hover {
        color: var(--accent);
      }
      .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-soft);
        font-size: 0.85rem;
        color: var(--ink-faint);
      }

      /* A real scale, so the page asserts a hierarchy instead of running at one
         size throughout. */
      h1, h2, h3 { line-height: 1.15; letter-spacing: -0.021em; font-weight: 650; }
      h1 { font-size: clamp(2.6rem, 5.4vw, 4rem); }
      h2 { font-size: clamp(1.75rem, 3vw, 2.4rem); }
      h3 { font-size: 1.12rem; letter-spacing: -0.01em; }

      /* The label above a section: small, spaced, quiet. Does the work a big
         heading would otherwise have to do twice. */
      .eyebrow {
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin: 0 0 0.75rem;
      }

      /* A full-width band. Sections that read as decisions rather than as one
         long column. */
      .band { background: var(--bg-deep); border-block: 1px solid var(--border-soft); }
      .band-inner { max-width: var(--max); margin: 0 auto; padding: 4.5rem 1.5rem; }

      /* Every render sits on a surface with an edge. These images are pale
         cream on a pale cream page, and without this they dissolve into it. */
      .plate {
        display: block;
        width: 100%;
        height: auto;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .status {
        display: inline-block;
        margin-left: 0.6rem;
        padding: 0.16rem 0.5rem;
        border-radius: 999px;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        vertical-align: 0.18em;
        border: 1px solid currentColor;
      }
      .status-soon { color: var(--ink-faint); }
      .status-beta { color: var(--accent); }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.85rem 1.35rem;
        border-radius: var(--radius);
        font-weight: 600;
        font-size: 1rem;
        border: 1px solid transparent;
        transition: transform 0.06s ease, background-color 0.15s ease, border-color 0.15s ease;
      }
      .btn:hover { text-decoration: none; transform: translateY(-1px); }
      .btn:active { transform: translateY(0); }

      .btn-primary {
        background: var(--ink);
        color: var(--surface);
      }
      .btn-primary:hover { background: #2c241a; }

      .btn-secondary {
        background: var(--surface);
        color: var(--ink);
        border-color: var(--border);
      }
      .btn-secondary:hover { border-color: var(--ink); }

      code, pre {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
    </style>
  </body>
</html>

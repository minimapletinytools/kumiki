---
import { kigumiVersion, releasePage } from '../kigumi-release';
import { type Lang, localePath, strings } from '../i18n';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: string;
  keywords?: string;
  faqs?: { question: string; answer: string }[];
  /** Let the page run full width and manage its own columns, so full-bleed
      section bands are actually full width rather than faked with 100vw. */
  wide?: boolean;
  lang?: Lang;
  /** The page is in every language: at canonicalPath and at /ja + canonicalPath. */
  translated?: boolean;
}

const {
  title,
  lang = 'en',
  translated = false,
  description = strings(lang).layout.description,
  image = '/photos/tinyhouse120_angle.png',
  canonicalPath,
  type = 'website',
  keywords = 'timber framing, woodworking CAD, programmatic CAD, Python CAD, Japanese joinery, parametric joinery, Kigumi, Kumiki, mortise and tenon, dovetail joint, scarf joint, kanawa-tsugi, koshikake kama-tsugi, VS Code CAD, agentic CAD, AI timber framing, OpenSCAD alternative, CadQuery alternative',
  faqs,
  wide = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const s = strings(lang).layout;
const other: Lang = lang === 'en' ? 'ja' : 'en';
// The other language's version of this page; an untranslated page offers the other's home page.
const otherHref = translated && canonicalPath ? localePath(other, canonicalPath) : localePath(other, '/');
const link = (path: string) => localePath(lang, path);
// Kigumi in the browser, at /try: built only when the KIGUMI_TRY repo variable is on (deploy-website.yml).
const tryKigumi = import.meta.env.PUBLIC_KIGUMI_TRY === 'true';
const siteUrl = 'https://kumiki.build';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const urlFor = (one: Lang, path: string) => `${siteUrl}${localePath(one, path).slice(base.length)}`;
const canonicalUrl = canonicalPath ? urlFor(lang, canonicalPath) : `${siteUrl}${pathname === '/' ? '/' : `${pathname}/`}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

const graphNodes: any[] = [
  {
    '@type': 'WebSite',
    '@id': 'https://kumiki.build/#website',
    url: 'https://kumiki.build/',
    name: 'Kumiki',
    alternateName: ['Kumiki CAD', 'Kumiki & Kigumi'],
    description: 'Programmatic CAD library for Python designed for timber framing and woodworking joinery.',
    inLanguage: 'en',
    publisher: {
      '@type': 'Organization',
      name: 'minimaple',
      url: 'https://kumiki.build/',
    },
    sameAs: [
      'https://github.com/minimapletinytools/kumiki',
      'https://pypi.org/project/kumiki/',
      'https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi',
      'https://open-vsx.org/extension/minimaple/kigumi',
      'https://www.youtube.com/playlist?list=PLWKU1B561fyM',
    ],
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://kumiki.build/#software-kumiki',
    name: 'Kumiki',
    applicationCategory: 'CADApplication, DeveloperApplication',
    operatingSystem: 'Cross-platform (macOS, Linux, Windows)',
    softwareVersion: kigumiVersion,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Programmatic CAD library for Python designed for timber framing and woodworking with parametric joinery, 2D shop drawings, assembly order verification, and AI agent workflows.',
    featureList: [
      'Parametric Japanese and Western timber joinery (mortise and tenon, dovetail, scarf, gooseneck, lap, housing)',
      'Exact symbolic rational arithmetic for dimensions and angles',
      'Wood grain orientation and reference arris/face semantics',
      'Automated 2D shop drawings and elevations',
      'Physical assembly sequence solver and timeline playback',
      'STEP, STL, OBJ, and 3MF export',
    ],
    screenshot: `${siteUrl}/photos/tinyhouse120_angle.png`,
    url: 'https://kumiki.build/',
    downloadUrl: 'https://pypi.org/project/kumiki/',
    codeRepository: 'https://github.com/minimapletinytools/kumiki',
    license: 'https://www.mozilla.org/MPL/2.0/',
  },
  {
    '@type': 'SoftwareSourceCode',
    '@id': 'https://kumiki.build/#source-kumiki',
    name: 'kumiki',
    codeRepository: 'https://github.com/minimapletinytools/kumiki',
    programmingLanguage: 'Python',
    runtimePlatform: 'Python >=3.10',
    version: kigumiVersion,
    license: 'https://www.mozilla.org/MPL/2.0/',
    targetProduct: { '@id': 'https://kumiki.build/#software-kumiki' },
  },
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://kumiki.build/#software-kigumi',
    name: 'Kigumi',
    applicationCategory: 'DeveloperApplication, CADApplication',
    operatingSystem: 'macOS, Windows, Visual Studio Code, Cursor, web browser',
    softwareVersion: kigumiVersion,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    description:
      'Interactive 3D timber frame viewer and editor for Kumiki: a desktop app for macOS and Windows, an extension for Visual Studio Code and Cursor, and a browser version with a built-in AI agent and MCP server.',
    url: 'https://kumiki.build/install/',
    installUrl: 'https://kumiki.build/install/',
    downloadUrl: 'https://kumiki.build/install/',
    releaseNotes: releasePage,
    screenshot: `${siteUrl}/photos/kigumi-tiny-house-workspace.webp`,
  },
];

const effectivePath = canonicalPath || pathname;
if (effectivePath && effectivePath !== '/') {
  graphNodes.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Kumiki',
        item: `${siteUrl}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: title.split('—')[0].trim(),
        item: canonicalUrl,
      },
    ],
  });
}

if (faqs && faqs.length > 0) {
  graphNodes.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Shippori+Mincho+B1:wght@600;700;800&display=swap" />

    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Canonical & Agent Discovery Links -->
    <link rel="canonical" href={canonicalUrl} />
    {translated && canonicalPath && (['en', 'ja'] as Lang[]).map((one) => (
      <link rel="alternate" hreflang={one} href={urlFor(one, canonicalPath)} />
    ))}
    {translated && canonicalPath && <link rel="alternate" hreflang="x-default" href={urlFor('en', canonicalPath)} />}
    <!-- A first visit from a Japanese browser goes to the Japanese page; the header's switch is remembered. -->
    {translated && lang === 'en' && (
      <script is:inline define:vars={{ target: otherHref }}>
        try {
          const chosen = localStorage.getItem('kumiki.lang');
          const browser = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
          if (chosen === 'ja' || (!chosen && browser.startsWith('ja'))) location.replace(target + location.hash);
        } catch (_error) {}
      </script>
    )}
    <link rel="alternate" type="text/markdown" title="LLM Context Summary" href={`${siteUrl}/llms.txt`} />
    <link rel="help" title="Comprehensive LLM Guide" href={`${siteUrl}/llms-full.txt`} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteUrl}/sitemap.xml`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Kumiki" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    {translated && <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={s.imageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- SEO Meta Tags -->
    <meta name="keywords" content={keywords} />
    <meta name="author" content="minimaple" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Cloudflare Web Analytics: cookieless page counts, on kumiki.build only (not local previews). -->
    <script is:inline>
    if (location.hostname === 'kumiki.build') {
      const beacon = document.createElement('script');
      beacon.type = 'module';
      beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      beacon.dataset.cfBeacon = '{"token": "7177885348334f15b71652a3e776a1ba"}';
      document.head.append(beacon);
    }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={link('/')}>
          <span class="hanko" aria-hidden="true">組</span>
          <span class="brand-text">Kumiki</span>
        </a>
        <nav class="site-nav" aria-label={s.nav.label}>
          <a href={link('/joints')}>{s.nav.joints}</a>
          <a class="nav-videos" href="https://www.youtube.com/playlist?list=PLWKU1B561fyM" target="_blank" rel="noreferrer">{s.nav.videos}</a>
          <a href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">{s.nav.github}</a>
          <a class="language-switch" href={otherHref} hreflang={other} lang={other} data-lang={other}
             aria-label={translated ? s.language.switchToLabel : s.language.switchToHomeLabel}>{s.language.switchTo}</a>
          <a class="nav-try" href={link('/install')}>{s.nav.try}</a>
        </nav>
      </div>
    </header>
    {Astro.slots.has('masthead') && (
      <section class="masthead dark grid-bg">
        <div class="masthead-inner"><slot name="masthead" /></div>
      </section>
    )}
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <footer class="site-footer dark">
      <div class="footer-inner">
        <div class="footer-mark" aria-hidden="true">
          <span class="footer-kanji">組木</span>
          <span class="footer-word">Kumiki</span>
        </div>
        <div class="footer-nav">
          <div class="footer-col">
            <h2 class="footer-heading">{s.footer.kigumi}</h2>
            <a href={link('/install')}>{s.footer.downloadApp}</a>
            {tryKigumi && <a href={`${base}/try/`}>{s.footer.tryInBrowser}</a>}
            <a href="https://marketplace.visualstudio.com/items?itemName=minimaple.kigumi" target="_blank" rel="noreferrer">{s.footer.vscode}</a>
            <a href="https://open-vsx.org/extension/minimaple/kigumi" target="_blank" rel="noreferrer">{s.footer.openVsx}</a>
            <a href="https://github.com/minimapletinytools/kumiki/releases" target="_blank" rel="noreferrer">{s.footer.releases}</a>
          </div>
          <div class="footer-col">
            <h2 class="footer-heading">{s.footer.documentation}</h2>
            <a href="https://kumiki.build/docs/">{s.footer.overview}</a>
            <a href="https://kumiki.build/docs/concepts/">{s.footer.concepts}</a>
            <a href={link('/joints')}>{s.footer.jointCatalog}</a>
            <a href="https://kumiki.build/docs/reference/">{s.footer.apiReference}</a>
          </div>
          <div class="footer-col">
            <h2 class="footer-heading">{s.footer.forAgents}</h2>
            <a href={`${base}/llms.txt`}>llms.txt</a>
            <a href={`${base}/llms-full.txt`}>llms-full.txt</a>
            <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/agent_usage_instructions.md" target="_blank" rel="noreferrer">{s.footer.authoringInstructions}</a>
            <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/api_cheat_sheet.md" target="_blank" rel="noreferrer">{s.footer.cheatSheet}</a>
          </div>
          <div class="footer-col">
            <h2 class="footer-heading">{s.footer.project}</h2>
            <a href="https://github.com/minimapletinytools/kumiki" target="_blank" rel="noreferrer">{s.footer.github}</a>
            <a href="https://www.youtube.com/playlist?list=PLWKU1B561fyM" target="_blank" rel="noreferrer">{s.footer.videos}</a>
            <a href={link('/about')}>{s.footer.about}</a>
            <a href="mailto:minimapletinytools@gmail.com">{s.footer.contact}</a>
          </div>
          <div class="footer-col">
            <h2 class="footer-heading">{s.footer.community}</h2>
            <a href="https://github.com/minimapletinytools/kumiki/discussions" target="_blank" rel="noreferrer">{s.footer.discussions}</a>
            <a href="https://discord.gg/cQhUG7WJ8" target="_blank" rel="noreferrer">{s.footer.discord}</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span set:html={s.footer.copyright} />
        <span class="footer-legal"><a href={`${base}/privacy/`}>{s.footer.privacy}</a> <a href={`${base}/terms/`}>{s.footer.terms}</a></span>
      </div>
    </footer>
    <script>
      // The language switch is remembered, so a Japanese browser that picks English stays there.
      document.querySelector<HTMLAnchorElement>('.language-switch')?.addEventListener('click', (event) => {
        try {
          localStorage.setItem('kumiki.lang', (event.currentTarget as HTMLAnchorElement).dataset.lang ?? 'en');
        } catch (_error) {}
      });

      // Elements marked data-reveal rise into place the first time they scroll into view.
      const revealed = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            observer.unobserve(entry.target);
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        revealed.forEach((element) => observer.observe(element));
      } else {
        revealed.forEach((element) => element.classList.add('in'));
      }

      // The header darkens and gains an edge once the page has scrolled.
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
    <style is:global>
      :root {
        /* Sumi black, washi paper, hinoki and a vermilion seal. */
        --sumi: #13110f;
        --sumi-2: #1c1916;
        --sumi-3: #2a2521;
        --on-dark: #f3ece0;
        --on-dark-soft: #b8afa2;
        --on-dark-faint: #8a8176;
        --line-dark: rgba(243, 236, 224, 0.12);
        --line-dark-strong: rgba(243, 236, 224, 0.22);

        --paper: #f4efe6;
        --paper-2: #ebe3d5;
        --sheet: #fffdf8;
        --wood: #ebe3d5;
        --ink: #1a1714;
        --ink-soft: #4f4943;
        --ink-faint: #7b736b;
        --rule: #ddd4c6;
        --rule-strong: #c6bba9;

        --shu: #d4401f;
        --shu-deep: #b3341a;
        --shu-bright: #ff6a45;
        --hinoki: #e8c48c;
        --accent: #b3341a;
        --accent-deep: #8f2913;
        --accent-tint: #f8e2d9;

        --serif: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho", Georgia, serif;
        --sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Yu Gothic", Meiryo, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --max: 1240px;
        --gutter: clamp(1rem, 4vw, 2.5rem);
        --radius: 10px;
        --radius-sm: 6px;
        --shadow: 0 1px 2px rgba(19, 17, 15, 0.06), 0 12px 32px -12px rgba(19, 17, 15, 0.25);
        --shadow-lg: 0 2px 4px rgba(0, 0, 0, 0.2), 0 40px 80px -24px rgba(0, 0, 0, 0.6);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      body { overflow-x: clip; }
      ::selection { background: var(--shu); color: #fff; }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
      a:focus-visible, button:focus-visible, summary:focus-visible {
        outline: 2px solid var(--shu);
        outline-offset: 3px;
        border-radius: 3px;
      }

      /* A section on sumi: light text, hinoki links. */
      .dark { background: var(--sumi); color: var(--on-dark); }
      .dark a { color: var(--hinoki); }
      /* The blueprint grid behind dark sections. */
      .grid-bg {
        background-image:
          linear-gradient(var(--line-dark) 1px, transparent 1px),
          linear-gradient(90deg, var(--line-dark) 1px, transparent 1px),
          linear-gradient(rgba(243, 236, 224, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(243, 236, 224, 0.045) 1px, transparent 1px);
        background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
        background-position: -1px -1px;
      }

      /* ── Header ── */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: rgba(19, 17, 15, 0.82);
        backdrop-filter: saturate(1.4) blur(14px);
        -webkit-backdrop-filter: saturate(1.4) blur(14px);
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, background-color 0.2s ease;
      }
      .site-header.scrolled { background: rgba(19, 17, 15, 0.94); border-bottom-color: var(--line-dark); }
      .header-inner {
        max-width: var(--max);
        margin: 0 auto;
        padding: 0.8rem var(--gutter);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: var(--on-dark);
        font-family: var(--serif);
        font-weight: 800;
        font-size: 1.35rem;
        letter-spacing: 0.01em;
      }
      .brand:hover { text-decoration: none; }
      /* A seal stamp: vermilion, square, a little crooked. */
      .hanko {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 5px;
        background: var(--shu);
        color: #fff6ea;
        font-family: var(--serif);
        font-size: 1.2rem;
        line-height: 1;
        transform: rotate(-4deg);
        box-shadow: inset 0 0 0 2px rgba(255, 246, 234, 0.25);
        transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
      }
      .brand:hover .hanko { transform: rotate(4deg) scale(1.06); }

      .site-nav { display: flex; align-items: center; gap: 0.25rem 1.4rem; font-size: 0.95rem; }
      .site-nav a { color: var(--on-dark-soft); }
      .site-nav a:hover { color: var(--on-dark); text-decoration: none; }
      .site-nav .language-switch {
        padding: 0.2rem 0.65rem;
        border: 1px solid var(--line-dark-strong);
        border-radius: 999px;
        font-size: 0.85rem;
      }
      .site-nav .nav-try {
        padding: 0.45rem 1rem;
        border-radius: 999px;
        background: var(--shu);
        color: #fff;
        font-weight: 500;
        transition: background-color 0.15s ease, transform 0.15s ease;
      }
      .site-nav .nav-try:hover { background: var(--shu-bright); color: #fff; transform: translateY(-1px); }

      /* ── Masthead: a page's dark title band ── */
      .masthead { position: relative; overflow: hidden; }
      .masthead::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: 120px;
        background: linear-gradient(transparent, var(--sumi));
        pointer-events: none;
      }
      .masthead-inner {
        position: relative;
        z-index: 1;
        max-width: var(--max);
        margin: 0 auto;
        padding: clamp(3rem, 8vw, 6rem) var(--gutter) clamp(3rem, 6vw, 4.5rem);
      }
      .masthead h1 { color: var(--on-dark); max-width: 18em; text-wrap: balance; }
      .masthead .lead { margin-top: 1.25rem; font-size: 1.15rem; color: var(--on-dark-soft); max-width: 44rem; }
      .masthead .kicker { color: var(--shu-bright); }

      main { max-width: var(--max); margin: 0 auto; padding: 1rem var(--gutter) 6rem; }
      main.wide { max-width: none; padding: 0; }
      /* The column a wide page puts its own content back into. */
      .column { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }

      /* ── Footer ── */
      .site-footer { position: relative; overflow: hidden; font-size: 0.92rem; }
      .footer-inner {
        max-width: var(--max);
        margin: 0 auto;
        padding: 5rem var(--gutter) 2.5rem;
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
        gap: 3rem;
      }
      .footer-mark { display: flex; flex-direction: column; gap: 0.25rem; }
      .footer-kanji {
        font-family: var(--serif);
        font-weight: 800;
        font-size: clamp(4.5rem, 10vw, 8rem);
        line-height: 0.95;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--shu);
      }
      .footer-word { font-family: var(--serif); font-weight: 700; font-size: 1.5rem; color: var(--on-dark); padding-left: 0.3rem; }
      .footer-nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 2rem 1.5rem; }
      .footer-col { display: flex; flex-direction: column; gap: 0.55rem; }
      .footer-heading {
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--on-dark-faint);
        margin: 0 0 0.35rem;
      }
      .site-footer .footer-col a { color: var(--on-dark-soft); }
      .site-footer .footer-col a:hover { color: var(--hinoki); }
      .footer-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding: 1.5rem var(--gutter) 2.5rem;
        border-top: 1px solid var(--line-dark);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        font-size: 0.85rem;
        color: var(--on-dark-faint);
      }
      .footer-legal { display: flex; gap: 1.25rem; }
      .site-footer .footer-bottom a { color: inherit; }

      /* ── Type ── */
      h1, h2 { font-family: var(--serif); font-weight: 800; line-height: 1.08; letter-spacing: -0.015em; margin: 0; }
      h1 { font-size: clamp(2.5rem, 6vw, 4.6rem); }
      h2 { font-size: clamp(2rem, 4vw, 3.1rem); }
      h3 { font-size: 1.1rem; font-weight: 600; line-height: 1.35; margin: 0; }
      p { margin: 0; }
      /* Japanese headings break between phrases, not inside a word. */
      :lang(ja) :is(h1, h2, h3) { word-break: auto-phrase; letter-spacing: 0; }

      /* What a section is about: small mono capitals with a vermilion tick. */
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0 0 1rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .kicker::before { content: ''; width: 1.4rem; height: 2px; background: currentColor; }
      :lang(ja) .kicker { letter-spacing: 0.06em; }

      /* A full-width band of paper. */
      .band { background: var(--paper-2); }
      .band-inner { max-width: var(--max); margin: 0 auto; padding: clamp(4rem, 9vw, 7rem) var(--gutter); }

      /* A render on its sheet, as a print pinned to a board. */
      .plate {
        display: block;
        width: 100%;
        height: auto;
        background: var(--sheet);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .status {
        display: inline-block;
        padding: 0.05rem 0.5rem;
        border-radius: 999px;
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        line-height: 1.6;
        color: var(--shu-deep);
        background: var(--accent-tint);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.4rem;
        border-radius: 999px;
        font-family: var(--sans);
        font-weight: 500;
        font-size: 1rem;
        line-height: 1.3;
        border: 1px solid transparent;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      }
      .btn:hover { text-decoration: none; transform: translateY(-2px); }
      .btn-primary { background: var(--shu); color: #fff; box-shadow: 0 10px 24px -10px rgba(212, 64, 31, 0.8); }
      .btn-primary:hover { background: var(--shu-deep); color: #fff; }
      .dark .btn-primary, .dark .btn-primary:hover { color: #fff; }
      .dark .btn-primary:hover { background: var(--shu-bright); }
      .btn-secondary { background: var(--sheet); color: var(--ink); border-color: var(--rule-strong); }
      .btn-secondary:hover { border-color: var(--ink); color: var(--ink); }
      .btn-ghost { background: transparent; color: var(--on-dark); border-color: var(--line-dark-strong); }
      .dark .btn-ghost { color: var(--on-dark); }
      .btn-ghost:hover { border-color: var(--on-dark); background: rgba(243, 236, 224, 0.06); color: var(--on-dark); }
      .btn-sm { padding: 0.5rem 0.95rem; font-size: 0.9rem; }

      code, pre { font-family: var(--mono); font-size: 0.88em; }

      /* Questions, shared by the pages that have them. */
      .faq-list { border-top: 1px solid var(--rule-strong); }
      .faq-item { border-bottom: 1px solid var(--rule-strong); }
      .faq-item summary {
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        padding: 1.3rem 0;
        cursor: pointer;
        font-weight: 500;
        font-size: 1.05rem;
        transition: color 0.15s ease;
      }
      .faq-item summary:hover { color: var(--accent); }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-icon {
        position: relative;
        width: 2rem;
        height: 2rem;
        flex: none;
        border: 1px solid var(--rule-strong);
        border-radius: 50%;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.3s ease;
      }
      .faq-icon::before, .faq-icon::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        width: 0.75rem;
        height: 1.5px;
        margin: -0.75px 0 0 -0.375rem;
        background: var(--ink);
        transition: transform 0.25s ease, background-color 0.2s ease;
      }
      .faq-icon::after { transform: rotate(90deg); }
      .faq-item[open] .faq-icon { background: var(--shu); border-color: var(--shu); transform: rotate(180deg); }
      .faq-item[open] .faq-icon::before, .faq-item[open] .faq-icon::after { background: #fff; }
      .faq-item[open] .faq-icon::after { transform: rotate(0deg); }
      .faq-item p { padding: 0 3.5rem 1.5rem 0; color: var(--ink-soft); }

      @media (prefers-reduced-motion: no-preference) {
        .js [data-reveal] {
          opacity: 0;
          transform: translateY(28px);
          transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
          transition-delay: var(--delay, 0s);
        }
        .js [data-reveal].in { opacity: 1; transform: none; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; }
      }

      @media (max-width: 760px) {
        .footer-inner { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 3.5rem; }
        .site-nav { gap: 0.25rem 0.9rem; font-size: 0.9rem; }
        .nav-videos { display: none; }
      }
      @media (max-width: 480px) {
        .brand-text { display: none; }
        .site-nav .nav-try { padding: 0.4rem 0.85rem; }
      }
    </style>
  </body>
</html>

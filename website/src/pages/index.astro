---
import Layout from '../layouts/Layout.astro';
import { appDownloads, kigumiVersion, marketplace } from '../kigumi-release';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tryKigumi = import.meta.env.PUBLIC_KIGUMI_TRY === 'true';

// The tabs ARE the navigation: the strip selects, the panel slides. Each one says how the
// program works rather than what it is like.
const features = [
  {
    id: 'program',
    label: 'Program your frames',
    kicker: 'Python in, frame out',
    heading: 'Frame designs are parametric programs',
    body: `Timbers and joints are defined through python functions provided by kumiki. All code is parametric: Change a dimension and every
      joint that depends on it updates. Author your code agentically or by hand.`,
    points: [
      'Joints are functions: precise, customizable and documented',
      'Patterns compose: the same brace can be used under each beam',
      'Author your design together with any AI agent',
    ],
    image: `${base}/photos/feature_code.png`,
    imageAlt: 'Python source declaring mitered and keyed lap joints at a frame corner',
    second: `${base}/photos/oscarshed.png`,
    secondAlt: 'The shed that code builds, rendered in Kigumi',
  },
  {
    id: 'preview',
    label: 'See it in Kigumi',
    kicker: 'The viewer',
    heading: 'Kigumi shows the frame as you write it',
    body: `Kigumi runs your frame and draws it: as a desktop app for Mac and Windows, as a
      VS Code extension, or in your browser. Select a timber and read its dimensions, walk
      into a joint's geometry tree, hide layers, cut sections and measure.`,
    points: [
      'Inspect geometry down to a single face, edge or joint feature',
      'Layers, tags and per-member visibility for picking a frame apart',
      'X-ray and section views for reading a joint from the inside',
    ],
    image: `${base}/photos/double_sawhorse_xray.png`,
    imageAlt: 'X-ray view of a double sawhorse, showing the joinery inside the timbers',
    second: `${base}/photos/coffee_table.png`,
    secondAlt: 'A coffee table frame rendered in the viewer',
  },
  {
    id: 'joinery',
    label: 'Parametric joinery',
    kicker: 'Joints, not boolean cuts',
    heading: 'Traditional joints that stay correct when the timbers change',
    body: `Mortise and tenon, dovetails, half-laps, scarfs, wedged and pegged variants.
      Each one is a parametric joint that recuts itself when the timbers it joins move,
      change size, or meet at a different angle.`,
    points: [
      'Housings, shoulders, reliefs and pegs derived from the timbers,',
      'Highly configurable joints for complex designs and simple plain versions for square frames',
      'Dozens of joints, with more being added regularly',
    ],
    image: `${base}/photos/half_blind_cross_lap_joint_xray.png`,
    imageAlt: 'X-ray of a half-blind cross lap joint with keys',
    second: `${base}/photos/mortise_tenon_brace_joint.png`,
    secondAlt: 'A pegged mortise-and-tenon brace joint at an angle',
  },
  {
    id: 'drawings',
    label: 'Shop drawings',
    status: 'Beta',
    kicker: 'Drawings',
    heading: 'Plans and shop drawings made from the frame itself',
    body: `A drawing is a projection of the model, so it cannot drift from it. Kumiki lays
      out the views from the timbers themselves: you never place a viewport or a scale.`,
    points: [
      'A plan, and a dimensioned drawing for each distinct piece',
      'Generated and customized in code, where the drawing is part of the design',
      'Add a dimension by hand in Kigumi, and export sheets as PNG',
    ],
    image: `${base}/photos/feature_drawing.png`,
    imageAlt: 'A generated sheet: front elevation, plan, side elevation and isometric',
  },
  {
    id: 'assembly',
    label: 'Assembly order',
    status: 'Beta',
    kicker: 'Order of operations',
    heading: 'The order the frame goes together, worked out from the joinery',
    body: `Kumiki works out which timbers can be moved into place, and in what order, from
      the joints themselves. Then it plays it back so you can watch the frame come apart.`,
    points: [
      'Assembly order derived from how each joint actually goes together',
      'Scrub from assembled to disassembled to read a sequence',
      'Catches a frame that cannot be assembled before you cut it',
    ],
    image: `${base}/photos/feature_assembly.png`,
    imageAlt: 'A coffee table part-way disassembled, with the assembly timeline slider',
    second: `${base}/photos/feature_assembly_2.png`,
    secondAlt: 'The same frame at another point in the assembly sequence',
  },
];

const gallery = [
  { src: `${base}/photos/oscarshed_built.png`, alt: "Oscar's Shed, built: the finished structure" },
  { src: `${base}/photos/tinyhouse120_front.png`, alt: 'Tiny house frame, front view' },
  { src: `${base}/photos/timber_frame_shed.png`, alt: 'Full timber-framed shed model' },
  { src: `${base}/photos/sawhorsey.png`, alt: 'Sawhorse pattern' },
  { src: `${base}/photos/double_sawhorse.png`, alt: 'Double sawhorse with pegged joinery' },
  { src: `${base}/photos/round_crosslap_joint.png`, alt: 'Round crosslap joint detail' },
  { src: `${base}/photos/wedged_half_dovetail.png`, alt: 'Wedged half dovetail joint' },
  { src: `${base}/photos/dropin_dovetail_butt_joint.png`, alt: 'Drop-in dovetail butt joint' },
  { src: `${base}/photos/dropin_dovetail_butt_joint_xray.png`, alt: 'X-ray: drop-in dovetail butt joint' },
  { src: `${base}/photos/half_blind_cross_lap_joint.png`, alt: 'Half-blind cross lap joint with keys' },
  { src: `${base}/photos/splined_opposing_joint.png`, alt: 'Splined opposing scarf joint' },
  { src: `${base}/photos/splined_opposing_joint_xray.png`, alt: 'X-ray: splined opposing scarf joint' },
];

const faqs = [
  {
    question: 'What is Kumiki?',
    answer:
      'Kumiki is an open-source Python library for designing timber frames, post-and-beam buildings and woodworking joinery in code. Its companion, Kigumi, shows the frame in 3D as you write it, with X-ray joint inspection, the CSG tree, drawings and live parameters (kiwari).',
  },
  {
    question: 'What is Kigumi, and where does it run?',
    answer:
      'Kigumi is Kumiki’s viewer and editor. It runs your frame script and renders it in 3D. Get it as a desktop app for Mac and Windows, as an extension for VS Code and Cursor, or use it in your browser at kumiki.build/try. The app and the browser version also have a built-in agent.',
  },
  {
    question: 'How does Kumiki compare to OpenSCAD, CadQuery or FreeCAD for woodworking?',
    answer:
      'General-purpose CAD is.. general purpose. Joints are difficult to draw and aren’t easily reused. Kumiki is a domain specific CAD application. Joinery (mortise and tenon, dovetails, scarfs, half-laps, gooseneck splices, housings, pegs) is created from purpose built functions that will fit the shape of the joint to whatever member it joints. And unlike FreeCAD, all designs are written with code which is best suited for agentic authoring.'
  },
  {
    question: 'Can I use AI agents (Claude, Codex, Cursor, Copilot) to design frames with Kumiki?',
    answer:
      'Yes. Frames are plain Python with exact dimensions, which agents write well. Kigumi projects ship with authoring instructions and the concepts documentation, that the agent will find automatically. Kigumi’s MCP server lets the agents you already use build frames and look at them in the app.',
  },
  {
    question: 'What joints does Kumiki support?',
    answer:
      'More than 30 traditional and modern timber joints, each with parametric variations: mortise and tenon (square, housed, through, wedged, pegged, drawbored), lap joints (corner, cross, mitered, half-blind), dovetails (standard, wedged half-dovetail, drop-in), scarf and splice joints (splined opposing scarf, lapped gooseneck or kanawa-tsugi), tongue-and-fork rafter joints, and drop-in housed joist pockets.',
  },
  {
    question: 'Can Kumiki export 3D models and files for fabrication?',
    answer:
      'Yes. Kumiki exports frames and individual timbers to STL, OBJ and 3MF for rendering and 3D printing, and to STEP for CNC and other CAD software. Drawings export as PNG and SVG will be supported soon.',
  },
];
---
<Layout
  title="Kumiki — Programmatic CAD for Timber Framing & Woodworking Joinery"
  description="Kumiki is an open-source Python library for designing timber frames and woodworking joinery in code, with parametric joints and a live 3D viewer, Kigumi, for Mac, Windows, VS Code and the web."
  canonicalPath="/"
  image="/photos/tinyhouse120_angle.png"
  faqs={faqs}
  wide
>
  <div class="column">
    <section class="hero">
      <div class="hero-copy">
        <h1>Programmatic Timber Framing and Woodworking CAD</h1>
        <p class="tagline">
          Kumiki is an open-source Python library for timber framing and woodworking. Designs are just programs and every joint is parametrically sized to the timbers it joins. Since everything is built from code, kumiki frames can be authored with support from AI agents.
        </p>
        <div class="cta">
          <a class="btn btn-primary" id="download" href={appDownloads.macArm}
             data-mac={appDownloads.macArm} data-windows={appDownloads.windows} data-other={`${base}/install`}>
            Download for Mac
          </a>
          {tryKigumi && <a class="btn btn-secondary" href={`${base}/try/`}>Try it in your browser</a>}
        </div>
        <p class="also">
          Kigumi {kigumiVersion} for <a href={appDownloads.macArm}>Mac (Apple silicon)</a>,
          <a href={appDownloads.macIntel}>Mac (Intel)</a> and <a href={appDownloads.windows}>Windows</a>,
          or as a <a href={marketplace}>VS Code extension</a>. Free and open source.
        </p>
      </div>
      <figure class="sheet">
        <img src={`${base}/photos/tinyhouse120_angle.png`} alt="A tiny house frame designed in Kumiki" fetchpriority="high" decoding="async" />
        <figcaption class="title-block">
          <div><span>Frame</span>Tiny house</div>
          <div><span>Source</span><code>tinyhouse120.py</code></div>
          <div><span>Joints</span>Dovetails, mortise and tenon, laps</div>
        </figcaption>
      </figure>
    </section>
  </div>

  <section class="band" id="features">
    <div class="band-inner">
      <h2 class="features-title">How it works</h2>
      <div class="tabs" role="tablist" aria-label="What Kumiki does">
        {features.map((feature, i) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`tab-${feature.id}`}
            aria-controls={`panel-${feature.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-index={i}
          >
            {feature.label}
            {feature.status && <span class="status">{feature.status}</span>}
          </button>
        ))}
      </div>
      <div class="viewport" id="viewport">
        <div class="track" id="track">
          {features.map((feature, i) => (
            <section
              class="panel"
              role="tabpanel"
              id={`panel-${feature.id}`}
              aria-labelledby={`tab-${feature.id}`}
              inert={i !== 0}
            >
              <div class="panel-copy">
                <p class="kicker">{feature.kicker}</p>
                <h3 class="panel-heading">{feature.heading}</h3>
                <p class="panel-body">{feature.body}</p>
                <ul class="panel-points">
                  {feature.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
              <div class="panel-media">
                <img class="plate" src={feature.image} alt={feature.imageAlt} loading="lazy" decoding="async" />
                {feature.second && (
                  <img class="plate plate-second" src={feature.second} alt={feature.secondAlt} loading="lazy" decoding="async" />
                )}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="column">
    <section class="gallery">
      <h2>Built with Kumiki</h2>
      <p class="section-lead">Frames, joints and a finished shed. The patterns behind them ship with Kumiki.</p>
      <div class="grid">
        {gallery.map((photo, i) => (
          <figure>
            <button class="thumb" type="button" data-index={i} aria-label={`Open larger view: ${photo.alt}`}>
              <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
            </button>
          </figure>
        ))}
      </div>
    </section>

    <section class="agents" id="ai-agents">
      <div class="agents-header">
        <h2>Design with an agent</h2>
        <p class="section-lead">
          Frames are plain Python with exact dimensions, so a coding agent can write one from a
          description, build it, and look at what it made.
        </p>
      </div>
      <div class="agents-ways">
        <div>
          <h3>Kigumi’s agent</h3>
          <p>
            The agent panel in the Kigumi app and the browser version edits your frame files,
            checks that they build, and looks at the view. Sign in to a Kigumi account, or use
            your own OpenRouter key.
          </p>
        </div>
        <div>
          <h3>Your own agent</h3>
          <p>
            Claude Code, Codex and others can write frames too. Give them the
            <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/agent_usage_instructions.md">authoring instructions</a>,
            and turn on Kigumi’s MCP server in the app so they can build frames and see them.
          </p>
        </div>
      </div>
      <figure class="prompt">
        <figcaption>For example</figcaption>
        <blockquote>
          Make me a cute saw horse. It has 2 horizontal feet on a 1′×2′ footprint, with two vertical
          legs on top of the feet, and a horizontal beam resting on top of the 2 legs. There should
          also be a stretcher connecting the 2 legs in the middle. Join everything with mortise and
          tenon joinery with square pegs please!
        </blockquote>
      </figure>
    </section>

    <section class="faq" id="faq">
      <h2>Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <span>{faq.question}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <section class="band closing">
    <div class="band-inner closing-inner">
      <h2>Start with a mortise and tenon joint, end with a barn</h2>
      <p>
        kumiki is the library and kigumi is design application and environment for building kumiki frames. Installion is easy and setup is automatic.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={`${base}/install`}>Get started</a>
        <a class="btn btn-secondary" href="https://kumiki.build/docs/">Read the docs</a>
      </div>
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image">&#8249;</button>
    <img class="lightbox-image" id="lightbox-image" src="" alt="" />
    <button class="lightbox-nav lightbox-next" type="button" aria-label="Next image">&#8250;</button>
    <p class="lightbox-caption" id="lightbox-caption"></p>
  </div>
</Layout>

<script>
  // --- the sliding feature gallery -----------------------------------------
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));
  const track = document.getElementById('track');

  const viewport = document.getElementById('viewport');
  let current = 0;

  // All five panels stay laid out side by side -- that is what the track
  // slides along -- so the viewport is told how tall the visible one is.
  // Without this it would stand at the height of the tallest panel and the
  // short ones would sit in a pool of whitespace.
  function syncHeight() {
    if (!viewport || !panels[current]) return;
    viewport.style.height = `${panels[current].offsetHeight}px`;
  }

  // Measured rather than expressed as a percentage: the step is one panel plus
  // the gutter between them, and Chrome rejects the calc() that would say so.
  function slide() {
    if (!track || panels.length === 0) return;
    const step = panels.length > 1 ? panels[1].offsetLeft - panels[0].offsetLeft : 0;
    track.style.transform = `translateX(${-current * step}px)`;
  }

  function select(index: number, focusTab = false) {
    if (!track || tabs.length === 0) return;
    const next = (index + tabs.length) % tabs.length;
    current = next;
    tabs.forEach((tab, i) => {
      const on = i === next;
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      tab.tabIndex = on ? 0 : -1;
    });
    // inert rather than hidden: the off-screen panels must keep their place in
    // the track, but their links and images should stay out of the tab order
    // and off a screen reader.
    panels.forEach((panel, i) => {
      if (i === next) panel.removeAttribute('inert');
      else panel.setAttribute('inert', '');
    });
    slide();
    syncHeight();
    if (focusTab) tabs[next].focus();
    history.replaceState(null, '', `#${panels[next].id.replace('panel-', '')}`);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    tab.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); select(i + 1, true); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(i - 1, true); }
      if (event.key === 'Home') { event.preventDefault(); select(0, true); }
      if (event.key === 'End') { event.preventDefault(); select(tabs.length - 1, true); }
    });
  });

  // Deep link: /#joinery opens that panel.
  const wanted = window.location.hash.replace('#', '');
  if (wanted) {
    const found = panels.findIndex((panel) => panel.id === `panel-${wanted}`);
    if (found >= 0) select(found);
  }

  // The panel grows when its images arrive and when the column reflows, and
  // both happen after the height above was measured.
  function reflow() { slide(); syncHeight(); }
  reflow();
  window.addEventListener('resize', reflow);
  if (typeof ResizeObserver !== 'undefined') {
    const observer = new ResizeObserver(reflow);
    panels.forEach((panel) => observer.observe(panel));
  }

  // --- gallery lightbox -----------------------------------------------------
  const gallery = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));
  const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-prev');
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox-next');

  let currentIndex = 0;

  function show(index: number) {
    if (!lightbox || !lightboxImage || gallery.length === 0) return;
    currentIndex = (index + gallery.length) % gallery.length;
    const img = gallery[currentIndex].querySelector('img');
    if (!img) return;
    lightboxImage.src = img.src;
    lightboxImage.alt = img.alt;
    if (lightboxCaption) lightboxCaption.textContent = img.alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
  }

  gallery.forEach((btn, i) => btn.addEventListener('click', () => show(i)));
  closeBtn?.addEventListener('click', close);
  prevBtn?.addEventListener('click', () => show(currentIndex - 1));
  nextBtn?.addEventListener('click', () => show(currentIndex + 1));
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) close(); });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(currentIndex - 1);
    if (e.key === 'ArrowRight') show(currentIndex + 1);
  });
</script>

<script>
  // The download button offers this computer's installer: Windows, a Mac, or the install page.
  const download = document.getElementById('download') as HTMLAnchorElement | null;
  if (download) {
    const agent = navigator.userAgent;
    if (/Windows/.test(agent)) {
      download.href = download.dataset.windows ?? download.href;
      download.textContent = 'Download for Windows';
    } else if (!/Macintosh|Mac OS X/.test(agent) || /iPhone|iPad/.test(agent)) {
      download.href = download.dataset.other ?? download.href;
      download.textContent = 'Get Kigumi';
    }
  }
</script>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    gap: 3.5rem;
    align-items: center;
    padding: 3rem 0 5rem;
  }
  .hero h1 { font-size: clamp(2.3rem, 4.2vw, 3.3rem); max-width: 16ch; }
  .tagline { margin-top: 1.4rem; font-size: 1.12rem; color: var(--ink-soft); max-width: 34rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .also { margin-top: 1.1rem; font-size: 0.9rem; color: var(--ink-faint); max-width: 32rem; }

  /* The hero render as a drawing sheet, with a title block along the bottom. */
  .sheet {
    margin: 0;
    background: var(--sheet);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .sheet img { display: block; width: 100%; height: auto; }
  .title-block {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    border-top: 1px solid var(--rule-strong);
    font-size: 0.9rem;
  }
  .title-block div { padding: 0.6rem 0.9rem 0.7rem; }
  .title-block div + div { border-left: 1px solid var(--rule); }
  .title-block span { display: block; font-size: 0.75rem; color: var(--ink-faint); }
  .title-block code { font-size: 0.85rem; }

  /* ── How it works ── */
  .features-title { margin-bottom: 1.75rem; }
  .tabs {
    display: flex;
    gap: 0.25rem 2rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule-strong);
  }
  .tab {
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.6rem 0 0.8rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink-soft);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected='true'] { color: var(--ink); font-weight: 500; border-bottom-color: var(--accent); }

  .viewport { overflow: hidden; transition: height 0.3s ease; }
  .track { display: flex; align-items: flex-start; gap: 4rem; transition: transform 0.45s cubic-bezier(0.3, 0.7, 0.2, 1); }
  .panel {
    flex: 0 0 100%;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3.5rem;
    padding-top: 2.75rem;
    align-items: start;
  }
  .panel-heading { font-family: var(--serif); font-size: clamp(1.45rem, 2.4vw, 1.9rem); font-weight: 700; line-height: 1.2; }
  .panel-body { margin-top: 1rem; color: var(--ink-soft); }
  .panel-points { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .panel-points li {
    padding: 0.6rem 0 0.6rem 1.4rem;
    border-top: 1px solid var(--rule-strong);
    position: relative;
    font-size: 0.95rem;
  }
  .panel-points li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 1.2rem;
    width: 0.55rem;
    height: 1px;
    background: var(--accent);
  }
  .panel-media { display: grid; gap: 1rem; }
  .plate-second { width: 55%; justify-self: end; }

  /* ── Gallery ── */
  .gallery { padding: 5.5rem 0 1rem; }
  .section-lead { margin-top: 0.75rem; color: var(--ink-soft); max-width: 40rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  .grid figure { margin: 0; }
  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--sheet);
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .thumb:hover img { transform: scale(1.03); }

  /* ── Agents ── */
  .agents { padding: 5.5rem 0 1rem; }
  .agents-ways {
    display: grid;

---
import Layout from '../layouts/Layout.astro';
import { appDownloads, kigumiVersion, marketplace, openVsx, releasePage } from '../kigumi-release';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tryKigumi = import.meta.env.PUBLIC_KIGUMI_TRY === 'true';

const installFaqs = [
  {
    question: 'Do I need to install Python before using Kigumi?',
    answer:
      'No. When you create or initialize a project in Kigumi, it sets up a project-local Python environment and installs Kumiki automatically, offering to install uv if no Python is present on your computer.',
  },
  {
    question: 'How do I connect Claude Code, Codex, or Antigravity to Kigumi?',
    answer:
      'Point your coding agent at the Kumiki authoring instructions (docs/agent_usage_instructions.md) and enable Kigumi’s built-in MCP server in the desktop app so the agent can build frames, read session logs, and inspect screenshots.',
  },
  {
    question: 'Can I install Kumiki directly with pip or uv?',
    answer:
      'Yes. Run pip install kumiki or uv add kumiki in any Python >=3.10 environment to build frames, export STEP/STL/3MF meshes, or render headless PNG views with kumiki.kigumi_at_home.',
  },
];
---
<Layout
  title="Get Started with Kumiki & Kigumi — Timber Framing CAD for Mac, Windows, VS Code and the Web"
  description="Download Kigumi for Mac or Windows, try it in your browser, or install the VS Code extension, and design your first timber frame with Kumiki."
  canonicalPath="/install"
  image="/photos/feature_code.png"
  faqs={installFaqs}
>
  <article class="install">
    <h1>Get started</h1>
    <p class="lead">
      You write frames in Python with Kumiki, and see them in Kigumi. Pick where you want Kigumi
      to run. Each one sets up Python and Kumiki for you.
    </p>

    <nav class="ways" aria-label="Ways to run Kigumi">
      <a href="#app">
        <strong>Desktop app</strong>
        <span>Mac and Windows. Editor, viewer and agent in one window.</span>
      </a>
      {tryKigumi && (
        <a href="#browser">
          <strong>In your browser</strong>
          <span>Nothing to install. Projects stay in the browser.</span>
        </a>
      )}
      <a href="#vscode">
        <strong>VS Code extension</strong>
        <span>For VS Code and Cursor, next to your own tools.</span>
      </a>
    </nav>

    <section id="app" class="way">
      <h2>Desktop app</h2>
      <ol class="steps">
        <li>
          <h3>Download and install Kigumi</h3>
          <div class="downloads">
            <a class="btn btn-primary btn-sm" href={appDownloads.macArm}>Mac, Apple silicon</a>
            <a class="btn btn-secondary btn-sm" href={appDownloads.macIntel}>Mac, Intel</a>
            <a class="btn btn-secondary btn-sm" href={appDownloads.windows}>Windows</a>
          </div>
          <p>
            Version {kigumiVersion} (<a href={releasePage}>release notes</a>). The app updates itself
            when a new version comes out. If Windows says it protected your PC, choose
            <strong>More info</strong>, then <strong>Run anyway</strong>.
          </p>
        </li>
        <li>
          <h3>Make a project</h3>
          <p>
            Choose <strong>New Project…</strong> and pick or make a folder. Kigumi installs Kumiki
            into it. If your computer has no Python, it offers to install
            <a href="https://docs.astral.sh/uv/">uv</a>, which brings its own.
          </p>
        </li>
        <li>
          <h3>Open your first frame</h3>
          <p>
            Click <strong>my_cute_frame</strong> in the explorer to see it. Open
            <code>my_cute_frame.py</code>, change a number and save: the view rebuilds.
          </p>
        </li>
        <li>
          <h3>Create your own designs</h3>
          <p>
            Author your own Python file that produces a <code>Frame</code> and it will show up in
            the viewer. Open the project folder with your AI coding agent to author agentically.
            Connect your agent to the Kigumi MCP for more features.
          </p>
        </li>
      </ol>
    </section>

    {tryKigumi && (
      <section id="browser" class="way">
        <h2>In your browser</h2>
        <p>
          Open <a href={`${base}/try/`}>kumiki.build/try</a>. Kigumi and Python run in the page,
          and nothing goes to a server. Your projects live in the browser’s storage, not on disk:
          export a project as a .zip to keep a copy. The first visit downloads Python, so it
          takes a moment.
        </p>
        <a class="btn btn-secondary btn-sm" href={`${base}/try/`}>Try Kigumi in your browser</a>
      </section>
    )}

    <section id="vscode" class="way">
      <h2>VS Code extension</h2>
      <ol class="steps">
        <li>
          <h3>Install the Kigumi extension</h3>
          <p>
            From the <a href={marketplace}>VS Code Marketplace</a>, or from
            <a href={openVsx}>Open VSX</a> for Cursor and other editors. There’s also a
            <code>.vsix</code> on the <a href={releasePage}>release page</a>.
          </p>
        </li>
        <li>
          <h3>Open a folder</h3>
          <p>Make a folder for your project, then choose <strong>File › Open Folder</strong>.</p>
        </li>
        <li>
          <h3>Initialize the project</h3>
          <p>
            Open the Kigumi sidebar from its icon in the activity bar, or run
            <strong>View: Show Kigumi</strong> from the command palette. Click
            <strong>Initialize Project</strong>: Kigumi installs Kumiki and adds a first frame.
          </p>
        </li>
        <li>
          <h3>Open your first frame</h3>
          <p>
            Click <strong>my_cute_frame</strong>. Edit <code>my_cute_frame.py</code> and click
            refresh in the viewer, or turn on auto refresh under <strong>Kigumi options</strong>.
          </p>
        </li>
      </ol>
    </section>

    <section class="way ai">
      <h2>Designing with AI</h2>
      <p>
        The Kigumi app and browser version have an agent panel: sign in, or add an OpenRouter key,
        and ask for a frame. Other coding agents can write frames too. We recommend Claude, Codex or
        Antigravity. Copilot and Cursor are not recommended, though Copilot’s free credits may be
        enough for a simple design. Point them at the
        <a href="https://github.com/minimapletinytools/kumiki/blob/main/docs/agent_usage_instructions.md">authoring instructions</a>,
        and in the app, turn on the MCP server so they can build frames and see them.
      </p>
      <figure class="prompt">
        <figcaption>Try asking</figcaption>
        <blockquote>
          Make me a cute saw horse. It has 2 horizontal feet on a 1′×2′ footprint, with two vertical
          legs on top of the feet, and a horizontal beam resting on top of the 2 legs. There should
          also be a stretcher connecting the 2 legs in the middle. Join everything with mortise and
          tenon joinery with square pegs please!
        </blockquote>
      </figure>
    </section>
  </article>
</Layout>

<style>
  .install { max-width: 46rem; margin: 0 auto; padding: 2.5rem 0 1rem; }
  .lead { margin-top: 1rem; font-size: 1.12rem; color: var(--ink-soft); }

  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin-top: 2.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--sheet);
  }
  .ways a { padding: 1rem 1.2rem 1.1rem; color: var(--ink); }
  .ways a + a { border-left: 1px solid var(--rule); }
  .ways a:hover { text-decoration: none; background: var(--accent-tint); }
  .ways strong { display: block; font-weight: 600; color: var(--accent); }
  .ways span { display: block; margin-top: 0.25rem; font-size: 0.9rem; color: var(--ink-soft); }

  .way { margin-top: 4rem; scroll-margin-top: 1.5rem; }
  .way > p { margin-top: 1rem; color: var(--ink-soft); }
  .way > .btn { margin-top: 1.25rem; }

  /* A sequence, so numbered: a counter in the margin, on a rule. */
  .steps { list-style: none; counter-reset: step; padding: 0; margin: 1.75rem 0 0; }
  .steps li {
    counter-increment: step;
    position: relative;
    padding: 0 0 2rem 3rem;
    border-left: 1px solid var(--rule-strong);
    margin-left: 0.9rem;
  }
  .steps li:last-child { padding-bottom: 0; border-left-color: transparent; }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: -0.9rem;
    top: -0.1rem;
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .steps p { margin-top: 0.45rem; color: var(--ink-soft); }
  .downloads { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }

  code {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.05rem 0.3rem;
  }

  .prompt {
    margin: 1.75rem 0 0;
    padding: 1.3rem 1.5rem;
    background: var(--sheet);
    border: 1px solid var(--rule-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  .prompt figcaption { font-size: 0.85rem; color: var(--ink-faint); margin-bottom: 0.4rem; }
  .prompt blockquote { margin: 0; font-family: var(--serif); font-size: 1.05rem; line-height: 1.65; }

  @media (max-width: 640px) {
    .ways a + a { border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>

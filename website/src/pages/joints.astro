---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = [
  {
    id: 'mortise-and-tenon',
    kicker: 'Posts, beams and braces',
    heading: 'Mortise and tenon',
    body: `The workhorse of a timber frame. A tenon on the end of one timber enters a mortise
      in the face of another, with optional housings, shoulders, draw-bored round or square
      pegs, wedges, or tusks. When a post or beam changes size, the tenon thickness, shoulder
      plane and peg holes recut to match.`,
    image: `${base}/photos/mortise_tenon_brace_joint.png`,
    imageAlt: 'Pegged mortise and tenon brace joint at an angle',
    second: `${base}/photos/wedged_half_dovetail.png`,
    secondAlt: 'Wedged half-dovetail through mortise and tenon joint',
    joints: [
      {
        name: 'Mortise and tenon (pegged, housed, or blind)',
        jp: '枘差し / Hozo-sashi',
        fn: 'cut_basic_mortise_and_tenon_joint_on_face_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/mixed/',
      },
      {
        name: 'Wedged half-dovetail mortise and tenon',
        jp: '車知栓仕口 / Shachi-sen',
        fn: 'cut_basic_wedged_half_dovetail_mortise_and_tenon_joint_on_face_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/butt/',
      },
      {
        name: 'Tusked through mortise and tenon',
        jp: '割り楔枘 / Warikusabi-hozo',
        fn: 'cut_basic_practice_tusked_mortise_and_tenon_joint_on_plane_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/mixed/',
      },
    ],
  },
  {
    id: 'butt-and-dropin',
    kicker: 'Joists, girts and opposing beams',
    heading: 'Drop-in and double butt joints',
    body: `Floor joists and girts often drop into pockets from above so they can be set after
      the main bents are raised. Where two beams meet from opposite sides of a post, a shared
      spline or opposing tenon ties them through the post without blowing out the mortise.`,
    image: `${base}/photos/dropin_dovetail_butt_joint.png`,
    imageAlt: 'Drop-in dovetail butt joint (ari-tsugi)',
    second: `${base}/photos/dropin_dovetail_butt_joint_xray.png`,
    secondAlt: 'X-ray view of a drop-in dovetail butt joint',
    joints: [
      {
        name: 'Drop-in dovetail butt joint',
        jp: '蟻落し仕口 / Ari-otoshi',
        fn: 'cut_dropin_dovetail_butt_joint_on_face_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/butt/',
      },
      {
        name: 'Drop-in housed butt joint',
        jp: '大入れ仕口 / Oire-shiguchi',
        fn: 'cut_basic_dropin_housed_butt_joint_on_face_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/butt/',
      },
      {
        name: 'Splined opposing double butt joint',
        jp: '雇い枘差し / Yatoi-hozo',
        fn: 'cut_basic_splined_opposing_double_butt_joint_on_face_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/butt/',
      },
    ],
  },
  {
    id: 'splice-and-scarf',
    kicker: 'Extending sills, plates and girts',
    heading: 'Splice and scarf joints',
    body: `When a mudsill or top plate runs longer than a single stick of lumber, a lengthening
      joint (tsugite) joins two collinear timbers end to end. From simple half-laps to
      interlocking gooseneck and rabbeted oblique scarfs, each cut is sized from the member's
      cross-section.`,
    image: `${base}/photos/gooseneck_joint.png`,
    imageAlt: 'Lapped gooseneck splice joint (koshikake kama-tsugi)',
    second: `${base}/photos/splined_opposing_joint_xray.png`,
    secondAlt: 'X-ray view of a splined opposing joint with pegs',
    joints: [
      {
        name: 'Lapped gooseneck splice',
        jp: '腰掛鎌継ぎ / Koshikake Kama-tsugi',
        fn: 'cut_basic_lapped_gooseneck_joint_on_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/splice/',
      },
      {
        name: 'Half-blind tenoned dadoed rabbeted scarf',
        jp: '金輪継ぎ / Kanawa-tsugi',
        fn: 'cut_basic_kanawa_tsugi_joint_on_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/splice/',
      },
      {
        name: 'Splice half-lap joint',
        jp: '相欠き継ぎ / Aikaki-tsugi',
        fn: 'cut_basic_plain_splice_lap_joint_on_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/splice/',
      },
    ],
  },
  {
    id: 'corner-and-cross',
    kicker: 'Sill corners, rafter peaks and crossing members',
    heading: 'Corner, bridle and cross-lap joints',
    body: `Corners meet as plain miters, half-laps, dovetails, tongue-and-fork (bridle) rafter
      peaks, or mitered-and-keyed laps that hide the end grain on the outside of the corner.
      Crossing timbers half-lap equally or house one member into a dado in the other.`,
    image: `${base}/photos/half_blind_cross_lap_joint.png`,
    imageAlt: 'Half-blind cross-lap joint with keys',
    second: `${base}/photos/half_blind_cross_lap_joint_xray.png`,
    secondAlt: 'X-ray view of a half-blind cross-lap joint with keys',
    joints: [
      {
        name: 'Mitered and keyed corner lap',
        jp: '箱相欠き車知栓仕口 / Hako Aikaki Shachi-sen',
        fn: 'cut_basic_mitered_and_keyed_lap_joint_on_plane_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/corner/',
      },
      {
        name: 'Tongue and fork corner (bridle joint)',
        jp: '組手 / Kumite',
        fn: 'cut_basic_tongue_and_fork_corner_joint_on_plane_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/corner/',
      },
      {
        name: 'Cross-lap and housing (dado) joints',
        jp: '渡り腮 / Watari-ago',
        fn: 'cut_basic_plain_cross_lap_joint_on_face_aligned_timbers',
        href: 'https://kumiki.build/docs/reference/joints/workshop/cross/',
      },
    ],
  },
];

const faqs = [
  {
    question: 'Why use Kumiki instead of OpenSCAD, CadQuery, FreeCAD or SketchUp for wood joinery?',
    answer:
      'In general-purpose CAD, a joint is a boolean subtraction you draw by hand: if you change a post from 4x4 to 6x6 or change a rafter angle, the mortise, shoulder and peg holes break. In Kumiki, every joint is a function of the timbers it connects, so shoulders, housings, tenon thicknesses and clearances recalculate automatically.',
  },
  {
    question: 'Does Kumiki support both Japanese joinery (kigumi) and Western timber framing?',
    answer:
      'Yes. Kumiki includes traditional Japanese splicing and connecting joints (koshikake kama-tsugi, kanawa-tsugi, ari-otoshi, oire-shiguchi, watari-ago) alongside classic Western square-rule and mill-rule timber framing joints (draw-bored mortise and tenon, tusked tenons, bridle joints, cross-laps and housings).',
  },
  {
    question: 'How do I choose between basic_joints and full joint functions?',
    answer:
      'Start with cut_basic_* functions (such as cut_basic_mortise_and_tenon_joint_on_face_aligned_timbers). They derive standard carpentry proportions—like a 1/3-width tenon—from the timbers automatically. When you need exact control over shoulder insets, tenon offsets or peg placement, switch to the underlying cut_* function.',
  },
];
---
<Layout
  title="Parametric Timber Joinery in Kumiki — Japanese & Western Woodworking Joints in Python"
  description="Explore Kumiki's parametric woodworking and timber framing joints in Python: mortise and tenon, wedged half-dovetails, drop-in dovetails (ari-tsugi), gooseneck splices (koshikake kama-tsugi), kanawa-tsugi scarfs, and cross-laps."
  canonicalPath="/joints"
  image="/photos/half_blind_cross_lap_joint_xray.png"
  faqs={faqs}
>
  <article class="joints-page">
    <p class="kicker">Parametric joinery</p>
    <h1>Traditional joints that recut themselves when the timbers change</h1>
    <p class="lead">
      In Kumiki, a joint is a function of the timbers it connects—not a boolean box you draw by
      hand. Change a timber’s cross-section, move a post, or steepen a roof pitch, and every
      shoulder, housing, tenon, wedge and peg hole is recomputed from the geometry.
    </p>

    <nav class="cat-nav" aria-label="Joint categories">
      {categories.map((cat) => (
        <a href={`#${cat.id}`}>
          <strong>{cat.heading}</strong>
          <span>{cat.kicker}</span>
        </a>
      ))}
    </nav>

    {categories.map((cat) => (
      <section id={cat.id} class="cat-section">
        <div class="cat-grid">
          <div class="cat-copy">
            <p class="kicker">{cat.kicker}</p>
            <h2>{cat.heading}</h2>
            <p class="cat-body">{cat.body}</p>
            <ul class="joint-list">
              {cat.joints.map((j) => (
                <li>
                  <div class="joint-header">
                    <a href={j.href}>{j.name}</a>
                    <span class="jp">{j.jp}</span>
                  </div>
                  <code>{j.fn}</code>
                </li>
              ))}
            </ul>
          </div>
          <div class="cat-media">
            <img class="plate" src={cat.image} alt={cat.imageAlt} loading="lazy" decoding="async" />
            {cat.second && (
              <img class="plate plate-second" src={cat.second} alt={cat.secondAlt} loading="lazy" decoding="async" />
            )}
          </div>
        </div>
      </section>
    ))}

    <section class="comparison" id="comparison">
      <h2>How Kumiki compares to general-purpose CAD</h2>
      <p class="section-lead">
        Mechanical CAD tools model arbitrary solids; Kumiki models timbers, grain direction,
        reference arrises and joinery rules.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Capability</th>
              <th>Kumiki + Kigumi</th>
              <th>OpenSCAD / CadQuery</th>
              <th>SketchUp / FreeCAD</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Built-in wood joinery</strong></td>
              <td>30+ parametric joints (M&amp;T, dovetails, scarfs, housings, pegs)</td>
              <td>Manual CSG boolean cutouts</td>
              <td>Manual drawing or static plugins</td>
            </tr>
            <tr>
              <td><strong>Resizing a timber</strong></td>
              <td>Shoulders, tenons, pockets and pegs recut automatically</td>
              <td>Requires rewriting coordinate math</td>
              <td>Often breaks adjacent faces</td>
            </tr>
            <tr>
              <td><strong>Wood grain &amp; local faces</strong></td>
              <td>First-class grain axis (<code>BOTTOM</code> to <code>TOP</code>) and reference edges</td>
              <td>None (isotropic meshes/BREPs)</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>Assembly order verification</strong></td>
              <td>Computed from joint insertion directions with timeline playback</td>
              <td>None</td>
              <td>None</td>
            </tr>
            <tr>
              <td><strong>AI agent authoring</strong></td>
              <td>Built-in agent, MCP server, exact symbolic rules, headless PNG render</td>
              <td>Prone to floating-point CSG misalignment</td>
              <td>GUI-bound, not text/git native</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="faq-section" id="faq">
      <h2>Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <span>{faq.question}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="cta-row">
      <a class="btn btn-primary" href={`${base}/install`}>Get Kigumi</a>
      <a class="btn btn-secondary" href="https://kumiki.build/docs/reference/joints/workshop/basic_joints/">
        Browse the Joint API Reference
      </a>
    </div>
  </article>
</Layout>

<style>
  .joints-page {
    padding: 2.5rem 0 2rem;
  }
  .lead {
    margin-top: 1.2rem;
    font-size: 1.12rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .cat-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.75rem;
    margin: 2.25rem 0 3.5rem;
  }
  .cat-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    background: var(--sheet);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--ink);
  }
  .cat-nav a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .cat-nav span {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .cat-section {
    padding: 3.25rem 0;
    border-top: 1px solid var(--rule-strong);
  }
  .cat-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 3rem;
    align-items: start;
  }
  .cat-body {
    margin-top: 0.9rem;
    color: var(--ink-soft);
  }
  .joint-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .joint-list li {
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .joint-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-weight: 500;
  }
  .jp {
    font-size: 0.85rem;
    color: var(--ink-faint);
    font-weight: 400;
  }
  .joint-list code {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
    word-break: break-all;
  }
  .cat-media {
    display: grid;
    gap: 1rem;
  }
  .plate-second {
    width: 60%;
    justify-self: end;
  }
  .comparison {
    padding: 3.5rem 0 1rem;
    border-top: 1px solid var(--rule-strong);
  }
  .section-lead {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    max-width: 40rem;
  }
  .table-wrap {
    margin-top: 1.75rem;
    overflow-x: auto;
    background: var(--sheet);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    text-align: left;
  }
  th, td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  th {
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    border-bottom: 1px solid var(--rule-strong);
  }
  tr:last-child td {
    border-bottom: 0;
  }
  .faq-section {
    padding: 3.5rem 0 2rem;
    max-width: 52rem;
  }
  .faq-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule-strong);
  }
  .faq-item {
    border-bottom: 1px solid var(--rule-strong);
  }
  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.05rem 0;
    cursor: pointer;
    font-weight: 500;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
    flex: none;
  }
  .faq-icon::before, .faq-icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    background: var(--ink-soft);
    transition: transform 0.2s ease;
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .faq-icon::after {
    transform: rotate(0deg);
  }
  .faq-item p {
    padding: 0 2rem 1.2rem 0;
    color: var(--ink-soft);
  }
  .cta-row {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  @media (max-width: 900px) {
    .cat-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
